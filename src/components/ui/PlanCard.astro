---
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import type { Plan } from '../../data/plans';
import { getRoomOptions, getDoorOptions } from '../../data/plans';

interface Props {
  plan: Plan;
  lang: Lang;
  reveal?: "left" | "right";
}

const { plan, lang, reveal = "left" } = Astro.props;
const t = useTranslations(lang);
const isCustom = plan.id === 'personalizado';

const roomOptions = getRoomOptions(lang);
const doorOptions = getDoorOptions(lang);

const currencyLocale = lang === 'es' ? 'es-PE' : 'en-US';
const formatPrice = (val: number) =>
  new Intl.NumberFormat(currencyLocale, {
    style: 'currency',
    currency: 'PEN',
    maximumFractionDigits: 0,
  }).format(val);

const initialPriceText = plan.monthlyPrice !== null ? formatPrice(plan.monthlyPrice) : '';
const ctaUrl = `${plan.ctaHref}?lang=${lang}`;
---

<div class="rounded-3xl bg-white p-6 sm:p-8 flex flex-col gap-6" data-reveal={reveal}>
  <div>
    <p class="eyebrow mb-2">{plan.badge}</p>
    <h3 class="text-3xl font-semibold font-display text-alivia-primary mb-2">{plan.name}</h3>
    <p class="text-base text-alivia-neutral-blue leading-relaxed">{plan.description}</p>
  </div>
  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
    {!isCustom ? (
      <>
        <span id={`price-${plan.id}`} class="text-5xl font-semibold font-display text-alivia-primary tabular-nums">
          {initialPriceText}
        </span>
        <span id={`period-${plan.id}`} class="text-base text-alivia-neutral-blue">{t("plans.perMonth")}</span>
      </>
    ) : (
      <>
        <span class="text-4xl sm:text-5xl font-semibold font-display text-alivia-primary">{t("plans.quotePrice")}</span>
        <span class="text-base text-alivia-neutral-blue">{t("plans.perEvaluation")}</span>
      </>
    )}
  </div>
  {!isCustom ? (
    <ul class="space-y-3 text-[0.9375rem] text-alivia-neutral-dark" aria-label={`${t("plans.featuresLabel")} ${plan.name}`}>
      {plan.features.map((f) => (
        <li class="flex items-start gap-3">
          {f.included ? (
            <svg class="w-5 h-5 mt-0.5 text-alivia-secondary-dark shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          ) : (
            <svg class="w-5 h-5 mt-0.5 text-alivia-neutral-light shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          )}
          {f.included ? f.label : <span class="text-alivia-neutral-blue">{f.label}</span>}
        </li>
      ))}
    </ul>
  ) : (
    <div class="flex flex-col gap-4">
      <div>
        <label for="room-select" class="block text-sm font-semibold text-alivia-neutral-gray mb-1.5">
          {t("plans.roomsLabel")}
        </label>
        <select id="room-select" class="w-full px-4 py-3 rounded-xl bg-alivia-surface border border-alivia-border text-alivia-primary text-base font-medium focus:outline-none focus-visible:ring-2 focus-visible:ring-alivia-primary-medium cursor-pointer">
          {roomOptions.map((opt) => <option>{opt}</option>)}
        </select>
      </div>
      <div>
        <label for="door-select" class="block text-sm font-semibold text-alivia-neutral-gray mb-1.5">
          {t("plans.doorsLabel")}
        </label>
        <select id="door-select" class="w-full px-4 py-3 rounded-xl bg-alivia-surface border border-alivia-border text-alivia-primary text-base font-medium focus:outline-none focus-visible:ring-2 focus-visible:ring-alivia-primary-medium cursor-pointer">
          {doorOptions.map((opt) => <option>{opt}</option>)}
        </select>
      </div>
    </div>
  )}
  <div class="mt-auto">
    <a
      href={ctaUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="press w-full flex items-center justify-center text-center px-6 min-h-13 rounded-xl text-base font-semibold bg-alivia-primary text-white hover:bg-alivia-primary-medium focus-visible:ring-4 focus-visible:ring-alivia-primary-light"
      aria-label={plan.ariaLabel}
    >
      {plan.ctaLabel}
    </a>
    <p class="text-center text-sm text-alivia-neutral-blue mt-3">{plan.ctaNote}</p>
  </div>
</div>
