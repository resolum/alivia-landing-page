---
import type { Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";
import type { LegalDoc } from "../../data/legal/types";
import { companyInfo } from "../../data/company";

interface Props {
  doc: LegalDoc;
  lang: Lang;
}

const { doc, lang } = Astro.props;
const t = useTranslations(lang);
---

<header class="mb-10 text-center sm:text-left space-y-4">
  <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2.5">
    {
      doc.meta.badge && (
        <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-alivia-secondary-mint text-alivia-secondary-dark border border-alivia-secondary-medium/40">
          {doc.meta.badge}
        </span>
      )
    }
    {
      companyInfo.complianceBadges.dataProtectionLaw && (
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-white text-alivia-primary border border-alivia-border shadow-xs">
          <svg class="w-3.5 h-3.5 text-alivia-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {t("legal.badgeLaw")}
        </span>
      )
    }
  </div>

  <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-display text-alivia-primary leading-tight">
    {doc.meta.title}
  </h1>

  <div class="flex flex-wrap items-center justify-center sm:justify-start gap-4 text-xs sm:text-sm text-alivia-neutral-gray pt-1">
    <div class="flex items-center gap-1.5">
      <svg class="w-4 h-4 text-alivia-neutral-light" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <span>{t("legal.lastUpdated")} <strong>{doc.meta.updated}</strong></span>
    </div>

    <span class="hidden sm:inline text-alivia-border">•</span>

    <div>
      <span>{t("legal.version")}: <strong>{doc.meta.version}</strong></span>
    </div>
  </div>
</header>
