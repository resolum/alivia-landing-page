---
import type { Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";
import type { LegalDoc } from "../../data/legal/types";
import { companyInfo } from "../../data/company";

interface Props {
  doc: LegalDoc;
  lang: Lang;
}

const { doc, lang } = Astro.props;
const t = useTranslations(lang);

const fullText = doc.sections
  .flatMap((s) => s.blocks)
  .map((b) => {
    if (b.type === "paragraph") return b.html.replace(/<[^>]*>/g, "");
    if (b.type === "list") return b.items.join(" ");
    if (b.type === "cards") return b.items.map((c) => c.title + " " + c.text).join(" ");
    if (b.type === "callout") return b.title + " " + b.text;
    return "";
  })
  .join(" ");

const wordCount = fullText.split(/\s+/).filter(Boolean).length;
const readingTimeMinutes = Math.max(1, Math.ceil(wordCount / 200));
---

<aside class="w-full lg:w-72 shrink-0 space-y-6 print:hidden">
  <details class="lg:hidden p-4 rounded-2xl bg-white border border-alivia-border shadow-sm group">
    <summary class="flex items-center justify-between cursor-pointer font-bold text-alivia-primary text-sm focus-visible:outline-none">
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-alivia-secondary-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
        </svg>
        {t("legal.tableOfContents")}
      </span>
      <span class="text-xs font-normal text-alivia-neutral-gray">{readingTimeMinutes} {t("legal.readingTime")}</span>
    </summary>
    <nav class="mt-4 pt-3 border-t border-alivia-border space-y-2 text-xs">
      {
        doc.sections.map((sec) => (
          <a
            href={`#${sec.id}`}
            class="toc-link block py-1 px-2 rounded hover:bg-alivia-surface text-alivia-neutral-dark hover:text-alivia-primary transition-colors"
          >
            <span class="font-bold text-alivia-secondary-dark mr-1.5">{sec.number}.</span>
            {sec.title}
          </a>
        ))
      }
    </nav>
  </details>

  <div class="hidden lg:block sticky top-28 p-5 rounded-2xl bg-white border border-alivia-border shadow-md space-y-5">
    <div class="flex items-center justify-between pb-3 border-b border-alivia-border">
      <h3 class="text-sm font-bold uppercase tracking-wider text-alivia-primary font-display">
        {t("legal.tableOfContents")}
      </h3>
      <span class="text-xs font-medium text-alivia-neutral-gray bg-alivia-surface px-2 py-0.5 rounded-full">
        ~{readingTimeMinutes} {t("legal.readingTime")}
      </span>
    </div>

    <nav class="space-y-1.5 text-xs max-h-[calc(100vh-16rem)] overflow-y-auto pr-1" aria-label={t("legal.tableOfContents")}>
      {
        doc.sections.map((sec) => (
          <a
            href={`#${sec.id}`}
            class="toc-link group flex items-start gap-2 py-1.5 px-2.5 rounded-xl text-alivia-neutral-dark hover:bg-alivia-surface hover:text-alivia-primary transition-all leading-snug"
          >
            <span class="font-bold text-alivia-secondary-dark shrink-0">{sec.number}.</span>
            <span class="group-hover:translate-x-0.5 transition-transform">{sec.title}</span>
          </a>
        ))
      }
    </nav>

    <div class="pt-4 border-t border-alivia-border space-y-2 text-xs bg-alivia-surface/50 p-3.5 rounded-xl">
      <h4 class="font-bold text-alivia-primary flex items-center gap-1.5">
        <svg class="w-4 h-4 text-alivia-secondary-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {t("legal.supportBoxTitle")}
      </h4>
      <p class="text-alivia-neutral-gray leading-relaxed">{t("legal.supportBoxDesc")}</p>
      <a
        href={`mailto:${companyInfo.privacyEmail}`}
        class="inline-block font-semibold text-alivia-primary hover:text-alivia-secondary underline"
      >
        {companyInfo.privacyEmail}
      </a>
    </div>
  </div>
</aside>
