---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import { getNavLinks } from "../data/nav";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { Image } from "astro:assets";
import logoImg from "../assets/logo.png";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const navLinks = getNavLinks(lang);
---

<header
  id="main-header"
  class="fixed top-0 left-0 right-0 z-50 bg-transparent text-white transition-all duration-300 py-4"
>
  <div
    class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4 lg:gap-6"
  >
    <div class="flex items-center gap-3 shrink-0">
      <a
        href="#"
        class="flex items-center gap-2 group focus-visible:ring-2 focus-visible:ring-alivia-secondary-medium rounded-lg p-1"
        aria-label={t("nav.logoAriaLabel")}
      >
        <Image
          src={logoImg}
          alt="Alivia Logo"
          class="w-20 h-20 sm:w-20 sm:h-20 object-contain group-hover:scale-105 transition-transform"
        />
        <span
          class="text-2xl font-bold tracking-tight text-white font-display group-hover:text-alivia-secondary transition-colors"
        >
          Alivia
        </span>
      </a>
      <span
        class="hidden 2xl:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium bg-alivia-primary-medium/40 backdrop-blur-md text-alivia-secondary-mint border border-alivia-secondary-medium/30 shrink-0"
      >
        <svg
          class="w-3.5 h-3.5 text-alivia-secondary"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        {t("nav.a11yBadge")}
      </span>
    </div>
    <nav
      class="hidden xl:flex items-center gap-3.5 2xl:gap-6 text-xs 2xl:text-sm font-semibold tracking-wide text-white/90 whitespace-nowrap"
      aria-label={t("nav.mainNavLabel")}
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="nav-link relative py-1 px-1.5 text-alivia-primary-mist hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
      <div class="hidden xl:block">
        <LanguageSwitcher currentLang={lang} />
      </div>
      <a
        href="https://resolum-alivia.alivia-resolum.workers.dev/"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden xl:inline-flex items-center gap-2 px-4 sm:px-5 py-2.5 rounded-full text-xs font-semibold bg-alivia-secondary text-alivia-primary-deep hover:bg-alivia-secondary-dark hover:text-white transition-all shadow-md focus-visible:ring-4 focus-visible:ring-alivia-secondary-medium touch-target whitespace-nowrap"
        aria-label={t("nav.loginAriaLabel")}
      >
        <svg
          class="w-4 h-4 shrink-0"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"
          ></path>
        </svg>
        <span>{t("nav.login")}</span>
      </a>
      <button
        id="mobile-menu-toggle"
        type="button"
        class="xl:hidden p-2.5 rounded-lg text-white hover:bg-white/10 transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary touch-target"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t("nav.mobileMenuToggle")}
      >
        <svg
          id="menu-icon-open"
          class="w-6 h-6 block"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="menu-icon-close"
          class="w-6 h-6 hidden"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>
  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu"
    class="hidden xl:hidden bg-alivia-primary-deep/95 backdrop-blur-xl border-b border-white/10 px-6 py-6 transition-all duration-300 max-h-[calc(100vh-4rem)] overflow-y-auto"
    aria-label={t("nav.mobileMenuLabel")}
  >
    <div class="flex flex-col gap-4 text-base font-medium text-white/90">
      <div class="flex items-center justify-between mb-2">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded bg-alivia-primary-medium/50 text-xs font-semibold text-alivia-secondary-medium w-fit"
        >
          {t("nav.a11yBadgeMobile")}
        </div>
        <LanguageSwitcher currentLang={lang} />
      </div>
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link py-2 border-b border-white/10 hover:text-alivia-secondary"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="https://resolum-alivia.alivia-resolum.workers.dev/"
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-nav-link mt-2 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full text-sm font-semibold bg-alivia-secondary text-alivia-primary-deep hover:bg-alivia-secondary-dark transition-all shadow-md"
      >
        <svg
          class="w-4 h-4 shrink-0"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"
          ></path>
        </svg>
        <span>{t("nav.login")}</span>
      </a>
    </div>
  </div>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const header = document.getElementById("main-header");
    const toggleBtn = document.getElementById("mobile-menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("menu-icon-open");
    const iconClose = document.getElementById("menu-icon-close");
    const mobileLinks = document.querySelectorAll(".mobile-nav-link");

    const comoFunciona = document.getElementById("como-funciona");

    const applyHeaderBackground = (active: boolean) => {
      if (!header) return;
      if (active) {
        header.classList.add(
          "bg-alivia-primary-deep/95",
          "backdrop-blur-xl",
          "shadow-2xl",
          "border-b",
          "border-alivia-primary-medium/50",
          "py-2",
        );
        header.classList.remove("bg-transparent", "py-4");
      } else {
        header.classList.remove(
          "bg-alivia-primary-deep/95",
          "backdrop-blur-xl",
          "shadow-2xl",
          "border-b",
          "border-alivia-primary-medium/50",
          "py-2",
        );
        header.classList.add("bg-transparent", "py-4");
      }
    };

    if (comoFunciona) {
      const headerObserver = new IntersectionObserver(
        ([entry]) => {
          applyHeaderBackground(
            !entry.isIntersecting
              ? (window.scrollY || document.documentElement.scrollTop) >=
                  comoFunciona.offsetTop - 80
              : true,
          );
        },
        { root: null, threshold: 0, rootMargin: "0px 0px 0px 0px" },
      );
      headerObserver.observe(comoFunciona);

      const updateHeaderBackground = () => {
        const scrollY = window.scrollY || document.documentElement.scrollTop;
        const triggerOffset = comoFunciona.offsetTop - 80;
        applyHeaderBackground(scrollY >= triggerOffset);
      };
      window.addEventListener("scroll", updateHeaderBackground);
      window.addEventListener("resize", updateHeaderBackground);
      updateHeaderBackground();
    }

    if (toggleBtn && mobileMenu) {
      toggleBtn.addEventListener("click", () => {
        const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true";
        toggleBtn.setAttribute("aria-expanded", String(!isExpanded));
        mobileMenu.classList.toggle("hidden");
        if (iconOpen && iconClose) {
          iconOpen.classList.toggle("hidden");
          iconClose.classList.toggle("hidden");
        }
      });

      mobileLinks.forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu.classList.add("hidden");
          toggleBtn.setAttribute("aria-expanded", "false");
          if (iconOpen && iconClose) {
            iconOpen.classList.remove("hidden");
            iconClose.classList.add("hidden");
          }
        });
      });
    }

    const sections = document.querySelectorAll("section[id], div[id]");
    const navLinks = document.querySelectorAll(".nav-link");

    const observerOptions = {
      root: null,
      rootMargin: "-20% 0px -70% 0px",
      threshold: 0,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute("id");
          navLinks.forEach((link) => {
            const href = link.getAttribute("href");
            if (href === `#${id}`) {
              link.classList.add("text-alivia-secondary", "font-bold");
              link.classList.remove(
                "text-alivia-primary-mist",
                "text-white/90",
              );
            } else {
              link.classList.remove("text-alivia-secondary", "font-bold");
              link.classList.add("text-alivia-primary-mist");
            }
          });
        }
      });
    }, observerOptions);

    sections.forEach((section) => observer.observe(section));
  });
</script>
