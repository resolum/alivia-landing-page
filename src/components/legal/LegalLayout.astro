---
import Layout from "../../layouts/Layout.astro";
import type { Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";
import LanguageSwitcher from "../LanguageSwitcher.astro";
import { companyInfo } from "../../data/company";
import logoImg from "../../assets/logo.webp";
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  lang: Lang;
  activeTab: "privacy" | "terms";
}

const { title, description, lang, activeTab } = Astro.props;
const t = useTranslations(lang);
const homeHref = lang === "es" ? "/es/" : "/";
const privacyHref =
  lang === "es" ? "/es/politica-de-privacidad" : "/privacy-policy";
const termsHref =
  lang === "es" ? "/es/terminos-y-condiciones" : "/terms-and-conditions";

const tabs = [
  { id: "privacy", href: privacyHref, label: t("legal.privacyTab") },
  { id: "terms", href: termsHref, label: t("legal.termsTab") },
] as const;

const facts = [
  companyInfo.complianceBadges.wcag && t("legal.badgeWcag"),
  companyInfo.complianceBadges.localEncryption && t("legal.badgeEncryption"),
].filter(Boolean);
---

<Layout title={title} description={description} lang={lang}>
  <a href="#main-content" class="skip-to-content">{t("legal.skipLink")}</a>
  <header class="legal-header relative lg:sticky top-0 z-40 bg-alivia-primary-deep text-white print:static">
    <div
      class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 pt-[env(safe-area-inset-top,0px)] grid grid-cols-[1fr_auto] lg:grid-cols-[1fr_auto_1fr] items-center gap-x-4"
    >
      <div class="flex items-center gap-5 h-16 min-w-0">
        <a
          href={homeHref}
          class="flex items-center gap-2 shrink-0 rounded-lg focus-visible:ring-2 focus-visible:ring-alivia-secondary"
        >
          <Image src={logoImg} alt="" class="w-9 h-9 object-contain" />
          <span class="text-xl font-semibold font-display">Alivia</span>
        </a>
        <a
          href={homeHref}
          class="hidden md:inline-flex items-center gap-1.5 min-h-11 text-sm font-medium text-alivia-primary-mist hover:text-alivia-secondary transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          {t("legal.backToHome")}
        </a>
      </div>

      <nav
        class="col-span-2 lg:col-span-1 row-start-2 lg:row-start-1 lg:col-start-2 pb-3 lg:pb-0 print:hidden"
        aria-label={lang === "es" ? "Documentos legales" : "Legal documents"}
      >
        <div class="relative grid grid-cols-2 p-1 rounded-xl bg-white/[0.07] text-sm font-semibold">
          {
            tabs.map((tab) => (
              <a
                href={tab.href}
                aria-current={activeTab === tab.id ? "page" : undefined}
                class:list={[
                  "relative flex items-center justify-center min-h-10 px-3 sm:px-5 rounded-lg text-center leading-tight transition-colors duration-200",
                  activeTab === tab.id
                    ? "text-alivia-primary-deep"
                    : "text-alivia-primary-mist hover:text-white",
                ]}
              >
                {activeTab === tab.id && (
                  <span class="legal-tab-pill absolute inset-0 rounded-lg bg-alivia-secondary" aria-hidden="true" />
                )}
                <span class="relative">{tab.label}</span>
              </a>
            ))
          }
        </div>
      </nav>

      <div class="flex justify-end items-center h-16 lg:col-start-3 print:hidden">
        <LanguageSwitcher currentLang={lang} />
      </div>
    </div>
  </header>

  <main id="main-content" class="legal-main bg-white text-alivia-neutral-dark">
    <slot />
  </main>

  <footer class="bg-alivia-primary-deep text-alivia-primary-mist pt-12 pb-[calc(2.5rem+env(safe-area-inset-bottom,0px))] print:hidden">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 grid gap-8 sm:grid-cols-[1fr_auto] items-end">
      <div class="space-y-2">
        <p class="text-2xl font-semibold font-display text-white">Alivia</p>
        <p class="text-[0.9375rem]">{companyInfo.legalName}</p>
        {facts.length > 0 && <p class="text-sm text-alivia-primary-light">{facts.join(" · ")}</p>}
        <p class="text-sm text-alivia-primary-light">
          © 2026 {companyInfo.tradeName}. {lang === "es" ? "Todos los derechos reservados." : "All rights reserved."}
        </p>
      </div>
      <div class="flex flex-wrap gap-x-6 gap-y-1 text-[0.9375rem]">
        {
          tabs.map((tab) => (
            <a
              href={tab.href}
              class="inline-flex items-center min-h-11 hover:text-alivia-secondary transition-colors aria-[current=page]:text-white"
              aria-current={activeTab === tab.id ? "page" : undefined}
            >
              {tab.label}
            </a>
          ))
        }
        <a href={homeHref} class="inline-flex items-center min-h-11 hover:text-alivia-secondary transition-colors">
          {t("legal.backToHome")}
        </a>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* Header and pill persist across Privacy ↔ Terms; the pill slides between tabs natively */
  .legal-header {
    view-transition-name: legal-header;
  }
  .legal-tab-pill {
    view-transition-name: legal-tab-pill;
  }
  .legal-main {
    view-transition-name: legal-main;
  }
</style>
