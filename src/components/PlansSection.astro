---
import { PLANS } from '../data/plans';
import PlanCard from './ui/PlanCard.astro';
---

<section id="planes" class="py-20 bg-alivia-surface text-alivia-primary">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-3xl mx-auto mb-10">
      <span class="text-xs uppercase tracking-widest font-bold text-alivia-secondary-dark">
        Sin sorpresas ni letras pequeñas
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold font-display mt-3 mb-4 text-alivia-primary">
        Planes Diseñados para Cada Necesidad
      </h2>
      <p class="text-base text-alivia-neutral-blue leading-relaxed">
        Instalación profesional certificada sin romper paredes, con retiro sin costo si tu ser querido no se adapta.
      </p>
    </div>
    <div class="flex justify-center mb-12">
      <div
        id="billing-tablist"
        role="tablist"
        aria-label="Período de facturación"
        class="relative inline-flex p-1.5 rounded-2xl bg-white border border-alivia-border shadow-sm"
      >
        <span
          id="billing-pill"
          aria-hidden="true"
          class="absolute top-1.5 left-1.5 h-[calc(100%-12px)] rounded-xl bg-alivia-primary shadow-md
                 transition-[width,transform] duration-300 ease-[cubic-bezier(.4,0,.2,1)] pointer-events-none"
        ></span>

        <button
          id="btn-mensual"
          role="tab"
          aria-selected="true"
          tabindex="0"
          class="billing-tab relative z-10 px-6 py-2.5 rounded-xl text-sm font-semibold transition-colors duration-300 text-white focus-visible:ring-4 focus-visible:ring-alivia-primary-medium"
        >
          Facturación Mensual
        </button>
        <button
          id="btn-anual"
          role="tab"
          aria-selected="false"
          tabindex="-1"
          class="billing-tab relative z-10 inline-flex items-center gap-2 px-6 py-2.5 rounded-xl text-sm font-semibold transition-colors duration-300 text-alivia-neutral-gray focus-visible:ring-4 focus-visible:ring-alivia-primary-medium"
        >
          Pago Anual
          <span class="text-[11px] font-bold text-alivia-secondary-dark bg-alivia-secondary-mint px-2 py-0.5 rounded-full">Ahorra 2 meses</span>
        </button>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
      {PLANS.map((plan) => <PlanCard plan={plan} />)}
    </div>
    <p class="text-center text-xs text-gray-400 flex items-center justify-center gap-2">
      <svg class="w-4 h-4 text-alivia-secondary-dark shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      Sin cobro de tarjeta en la landing. Al contratar serás redirigido de forma segura a nuestra plataforma de registro.
    </p>

  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const btnMensual   = document.getElementById("btn-mensual")  as HTMLButtonElement | null;
    const btnAnual     = document.getElementById("btn-anual")    as HTMLButtonElement | null;
    const pill         = document.getElementById("billing-pill") as HTMLElement | null;
    const priceEsencial  = document.getElementById("price-esencial");
    const periodEsencial = document.getElementById("period-esencial");

    if (!btnMensual || !btnAnual || !pill) return;

    const movePill = (btn: HTMLButtonElement) => {
      pill.style.width     = btn.offsetWidth + "px";
      pill.style.transform = `translateX(${btn.offsetLeft - 6}px)`;
    };

    movePill(btnMensual);
    window.addEventListener("resize", () => {
      const active = btnMensual.getAttribute("aria-selected") === "true" ? btnMensual : btnAnual;
      movePill(active);
    });

    const switchBilling = (active: HTMLButtonElement, inactive: HTMLButtonElement, isAnnual: boolean) => {
      movePill(active);
      active.setAttribute("aria-selected", "true");
      active.setAttribute("tabindex", "0");
      active.classList.add("text-white");
      active.classList.remove("text-alivia-neutral-gray");
      inactive.setAttribute("aria-selected", "false");
      inactive.setAttribute("tabindex", "-1");
      inactive.classList.remove("text-white");
      inactive.classList.add("text-alivia-neutral-gray");
      if (priceEsencial && periodEsencial) {
        priceEsencial.textContent  = isAnnual ? "S/ 83" : "S/ 99";
        periodEsencial.textContent = isAnnual ? "/ mes (cobro anual)" : "/ mes";
      }
      active.focus();
    };

    btnMensual.addEventListener("click", () => switchBilling(btnMensual, btnAnual, false));
    btnAnual.addEventListener(  "click", () => switchBilling(btnAnual,   btnMensual, true));
  });
</script>
