---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import { getPlans } from "../data/plans";
import PlanCard from "./ui/PlanCard.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const plans = getPlans(lang);

const currencyLocale = lang === "es" ? "es-PE" : "en-US";
const formatPrice = (val: number) =>
  new Intl.NumberFormat(currencyLocale, {
    style: "currency",
    currency: "PEN",
    maximumFractionDigits: 0,
  }).format(val);

const monthlyPriceFormatted = formatPrice(99);
const annualPriceFormatted = formatPrice(83);
const perMonthText = t("plans.perMonth");
const perMonthAnnualText = t("plans.perMonthAnnual");
---

<section id="planes" class="scroll-mt-24 py-20 sm:py-28 bg-alivia-surface text-alivia-primary">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-10" data-reveal>
      <h2
        class="text-[2rem] leading-[1.1] sm:text-5xl font-semibold font-display mb-5 text-alivia-primary"
      >
        {t("plans.title")}
      </h2>
      <p class="text-base sm:text-lg text-alivia-neutral-blue leading-relaxed">
        {t("plans.desc")}
      </p>
    </div>
    <div class="flex justify-center mb-12" data-reveal>
      <div
        id="billing-tablist"
        role="tablist"
        aria-label={t("plans.billingLabel")}
        class="relative flex w-full sm:w-auto sm:inline-flex p-1.5 rounded-2xl bg-white"
        data-monthly-price={monthlyPriceFormatted}
        data-annual-price={annualPriceFormatted}
        data-monthly-period={perMonthText}
        data-annual-period={perMonthAnnualText}
      >
        <span
          id="billing-pill"
          aria-hidden="true"
          class="absolute top-1.5 left-1.5 h-[calc(100%-12px)] rounded-xl bg-alivia-primary
                 transition-[width,transform] duration-300 ease-[var(--ease-in-out)] pointer-events-none"
        ></span>

        <button
          id="btn-mensual"
          role="tab"
          aria-selected="true"
          tabindex="0"
          class="billing-tab relative z-10 flex-1 sm:flex-none min-h-11 px-3 sm:px-6 py-2.5 rounded-xl leading-tight text-sm sm:text-base font-semibold transition-colors duration-200 text-white focus-visible:ring-4 focus-visible:ring-alivia-primary-medium"
        >
          {t("plans.monthly")}
        </button>
        <button
          id="btn-anual"
          role="tab"
          aria-selected="false"
          tabindex="-1"
          class="billing-tab relative z-10 flex-1 sm:flex-none min-h-11 inline-flex flex-col sm:flex-row items-center justify-center gap-1 sm:gap-2 px-3 sm:px-6 py-2 sm:py-2.5 rounded-xl leading-tight text-sm sm:text-base font-semibold transition-colors duration-200 text-alivia-neutral-gray focus-visible:ring-4 focus-visible:ring-alivia-primary-medium"
        >
          {t("plans.annual")}
          <span
            class="text-xs font-semibold text-alivia-primary bg-alivia-secondary-mint px-2 py-0.5 rounded-full whitespace-nowrap"
            >{t("plans.save2months")}</span
          >
        </button>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6" data-reveal-group>
      {plans.map((plan, i) => <PlanCard plan={plan} lang={lang} reveal={i % 2 ? "right" : "left"} />)}
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const btnMensual = document.getElementById(
      "btn-mensual",
    ) as HTMLButtonElement | null;
    const btnAnual = document.getElementById(
      "btn-anual",
    ) as HTMLButtonElement | null;
    const pill = document.getElementById("billing-pill") as HTMLElement | null;
    const priceEsencial = document.getElementById("price-esencial");
    const periodEsencial = document.getElementById("period-esencial");
    const tablist = document.getElementById("billing-tablist");

    if (!btnMensual || !btnAnual || !pill) return;

    const monthlyPrice = tablist?.getAttribute("data-monthly-price") || "S/ 99";
    const annualPrice = tablist?.getAttribute("data-annual-price") || "S/ 83";
    const monthlyPeriod =
      tablist?.getAttribute("data-monthly-period") || "/ mes";
    const annualPeriod =
      tablist?.getAttribute("data-annual-period") || "/ mes (cobro anual)";

    const movePill = (btn: HTMLButtonElement) => {
      pill.style.width = btn.offsetWidth + "px";
      pill.style.transform = `translateX(${btn.offsetLeft - 6}px)`;
    };

    // New price rises into place so the change is noticed, not just swapped
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const swapText = (el: HTMLElement, text: string) => {
      if (el.textContent === text) return;
      el.textContent = text;
      el.animate(
        reduceMotion
          ? [{ opacity: 0 }, { opacity: 1 }]
          : [
              { opacity: 0, transform: "translateY(8px)" },
              { opacity: 1, transform: "none" },
            ],
        { duration: 240, easing: "cubic-bezier(0.23, 1, 0.32, 1)" },
      );
    };

    movePill(btnMensual);
    window.addEventListener("resize", () => {
      const active =
        btnMensual.getAttribute("aria-selected") === "true"
          ? btnMensual
          : btnAnual;
      movePill(active);
    });

    const switchBilling = (
      active: HTMLButtonElement,
      inactive: HTMLButtonElement,
      isAnnual: boolean,
    ) => {
      movePill(active);
      active.setAttribute("aria-selected", "true");
      active.setAttribute("tabindex", "0");
      active.classList.add("text-white");
      active.classList.remove("text-alivia-neutral-gray");
      inactive.setAttribute("aria-selected", "false");
      inactive.setAttribute("tabindex", "-1");
      inactive.classList.remove("text-white");
      inactive.classList.add("text-alivia-neutral-gray");
      if (priceEsencial && periodEsencial) {
        swapText(priceEsencial, isAnnual ? annualPrice : monthlyPrice);
        swapText(periodEsencial, isAnnual ? annualPeriod : monthlyPeriod);
      }
      active.focus();
    };

    btnMensual.addEventListener("click", () =>
      switchBilling(btnMensual, btnAnual, false),
    );
    btnAnual.addEventListener("click", () =>
      switchBilling(btnAnual, btnMensual, true),
    );
  });
</script>
