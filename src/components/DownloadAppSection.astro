---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import PhoneMockup from "./PhoneMockup.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-12 bg-alivia-surface-mist">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div
      class="rounded-3xl bg-alivia-primary p-8 sm:p-10 relative overflow-hidden lg:overflow-visible shadow-xl"
    >
      <div
        class="absolute -right-16 -bottom-16 w-64 h-64 bg-alivia-secondary/20 rounded-full blur-3xl pointer-events-none"
      >
      </div>

      <div
        class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-6 items-center"
      >
        <div class="space-y-4 lg:col-span-5">
          <span
            class="text-xs uppercase tracking-widest font-extrabold text-alivia-secondary"
          >
            {t("download.badge")}
          </span>
          <h2
            class="text-3xl sm:text-4xl font-bold font-display text-white leading-tight"
          >
            {t("download.title")}
          </h2>
          <p
            class="text-sm sm:text-base text-alivia-primary-mist leading-relaxed font-normal"
          >
            {t("download.desc")}
          </p>
        </div>
        <div
          class="flex flex-col sm:flex-row lg:flex-col gap-3.5 lg:col-span-3 items-stretch sm:items-center lg:items-start justify-center"
        >
          <button
            type="button"
            id="btn-google-play"
            class="w-full sm:w-auto lg:w-full min-w-[210px] px-6 py-4 rounded-2xl bg-white text-alivia-primary hover:bg-alivia-surface transition-all shadow-md focus-visible:ring-4 focus-visible:ring-alivia-secondary touch-target flex items-center gap-4 group ring-4 ring-alivia-secondary cursor-pointer text-left"
            aria-label={t("download.googlePlayLabel")}
          >
            <svg
              class="w-8 h-8 shrink-0 text-alivia-primary group-hover:scale-105 transition-transform"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M3.609 1.814L13.792 12 3.61 22.186a1.986 1.986 0 0 1-.609-1.423V3.237c0-.55.228-1.047.608-1.423zM15.206 13.414l2.457 2.457-11.954 6.84 9.497-9.297zM15.206 10.586L5.709 1.289l11.954 6.84-2.457 2.457zm2.343 2.343l3.298-1.886c.645-.369.645-.969 0-1.338l-3.298-1.886-2.128 2.128 2.128 2.128z"
              ></path>
            </svg>
            <div class="text-left">
              <span
                class="block text-[10px] uppercase font-semibold text-gray-500"
                >{t("download.googlePlayBadge")}</span
              >
              <span class="text-base font-bold text-alivia-primary"
                >Google Play</span
              >
            </div>
          </button>
          <button
            type="button"
            id="btn-app-store"
            class="w-full sm:w-auto lg:w-full min-w-[210px] px-6 py-4 rounded-2xl bg-white text-alivia-primary hover:bg-alivia-surface transition-all shadow-md focus-visible:ring-4 focus-visible:ring-alivia-secondary touch-target flex items-center gap-4 group cursor-pointer text-left"
            aria-label={t("download.appStoreLabel")}
          >
            <svg
              class="w-8 h-8 shrink-0 text-alivia-primary group-hover:scale-105 transition-transform"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.32c.66-.8 1.11-1.92.99-3.04-.96.04-2.12.64-2.8 1.44-.61.71-1.15 1.86-1.01 2.97 1.08.08 2.17-.57 2.82-1.37z"
              ></path>
            </svg>
            <div class="text-left">
              <span
                class="block text-[10px] uppercase font-semibold text-gray-500"
                >{t("download.appStoreBadge")}</span
              >
              <span class="text-base font-bold text-alivia-primary"
                >App Store</span
              >
            </div>
          </button>
        </div>
        <div
          class="lg:col-span-4 flex justify-center lg:justify-end pt-4 lg:pt-0"
        >
          <div
            class="transform rotate-0 lg:rotate-5 transition-transform duration-500 lg:-mt-10 lg:-mb-10"
          >
            <PhoneMockup initialOS="android" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupStoreButtons() {
    const btnGooglePlay = document.getElementById("btn-google-play");
    const btnAppStore = document.getElementById("btn-app-store");
    const phoneFrame = document.getElementById("phone-mockup-frame");
    const notchAndroid = document.getElementById("notch-android");
    const notchIos = document.getElementById("notch-ios");
    const osTag = document.getElementById("phone-os-tag");
    const homebarAndroid = document.getElementById("homebar-android");
    const homebarIos = document.getElementById("homebar-ios");

    if (!btnGooglePlay || !btnAppStore) return;

    const activeRingClasses = ["ring-4", "ring-alivia-secondary"];

    function setOS(os: "android" | "ios") {
      if (os === "android") {
        btnGooglePlay?.classList.add(...activeRingClasses);
        btnAppStore?.classList.remove(...activeRingClasses);

        notchAndroid?.classList.remove("hidden");
        notchIos?.classList.add("hidden");

        if (osTag) osTag.textContent = "Alivia Android";

        homebarAndroid?.classList.remove("hidden");
        homebarIos?.classList.add("hidden");

        phoneFrame?.setAttribute("data-os", "android");
      } else {
        btnAppStore?.classList.add(...activeRingClasses);
        btnGooglePlay?.classList.remove(...activeRingClasses);

        notchAndroid?.classList.add("hidden");
        notchIos?.classList.remove("hidden");

        if (osTag) osTag.textContent = "Alivia iOS";

        homebarAndroid?.classList.add("hidden");
        homebarIos?.classList.remove("hidden");

        phoneFrame?.setAttribute("data-os", "ios");
      }
    }

    btnGooglePlay.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      setOS("android");
    });

    btnAppStore.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      setOS("ios");
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupStoreButtons);
  } else {
    setupStoreButtons();
  }
  document.addEventListener("astro:page-load", setupStoreButtons);
</script>
