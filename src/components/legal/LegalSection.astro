---
import type { LegalSectionItem } from "../../data/legal/types";
import type { Lang } from "../../i18n/ui";
import LegalBlocks from "./LegalBlocks.astro";

interface Props {
  section: LegalSectionItem;
  lang: Lang;
}

const { section, lang } = Astro.props;
---

<section id={section.id} class="legal-section scroll-mt-6 lg:scroll-mt-28 [&+&]:mt-14 sm:[&+&]:mt-20" aria-labelledby={`${section.id}-title`}>
  <h2 id={`${section.id}-title`} class="text-2xl sm:text-3xl font-semibold font-display text-alivia-primary leading-tight">
    <span class="text-alivia-secondary-dark tabular-nums">{section.number}.</span> {section.title}
  </h2>
  {section.subtitle && <p class="mt-2 text-alivia-neutral-blue">{section.subtitle}</p>}
  <div class="mt-6">
    <LegalBlocks blocks={section.blocks} lang={lang} />
  </div>
</section>
