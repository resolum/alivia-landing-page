---
import LegalLayout from "./LegalLayout.astro";
import LegalHero from "./LegalHero.astro";
import TableOfContents from "./TableOfContents.astro";
import LegalSection from "./LegalSection.astro";
import ReadingSizeToggle from "./ReadingSizeToggle.astro";
import Callout from "../ui/Callout.astro";
import { getLegalDoc } from "../../data/legal";
import type { Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const doc = getLegalDoc("privacy", lang);
---

<LegalLayout title={doc.meta.title} description={doc.meta.description} lang={lang} activeTab="privacy">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <LegalHero doc={doc} lang={lang} />

    <div class="flex flex-wrap items-center justify-between gap-3 mb-8 pb-4 border-b border-alivia-border print:hidden">
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="btn-expand-all"
          class="px-3.5 py-2 rounded-xl border border-alivia-border bg-white text-xs font-semibold text-alivia-primary hover:bg-alivia-surface transition-all shadow-xs focus-visible:ring-2 focus-visible:ring-alivia-secondary touch-target"
        >
          {t("legal.expandAll")}
        </button>
        <button
          type="button"
          id="btn-collapse-all"
          class="px-3.5 py-2 rounded-xl border border-alivia-border bg-white text-xs font-semibold text-alivia-primary hover:bg-alivia-surface transition-all shadow-xs focus-visible:ring-2 focus-visible:ring-alivia-secondary touch-target"
        >
          {t("legal.collapseAll")}
        </button>
      </div>
      <ReadingSizeToggle lang={lang} />
    </div>

    {
      doc.introCard && (
        <div class="mb-8">
          <Callout variant="info" title={doc.introCard.title} text={doc.introCard.text} />
        </div>
      )
    }

    <div class="flex flex-col lg:flex-row gap-10 items-start">
      <TableOfContents doc={doc} lang={lang} />

      <div id="legal-doc-content" class="flex-1 w-full min-w-0 transition-all text-base">
        {doc.sections.map((sec) => <LegalSection section={sec} mode="accordion" lang={lang} />)}
      </div>
    </div>
  </div>
</LegalLayout>

<script src="../../scripts/legal/legalInteractions.ts"></script>
