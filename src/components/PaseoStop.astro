---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import { PASEO_STOPS } from "../data/paseo";
import { stopLengths } from "../scripts/heroTimeline";

// One stop of the hero walk. The <article> sets how far the visitor scrolls on this stop; the text
// stays pinned at the bottom while the camera moves and fades in once the camera is standing still.
interface Props {
  lang: Lang;
  index: number;
  /** Small label above the headline. Stop 0 puts it inside its own h1 instead. */
  eyebrow?: string;
}

const { lang, index, eyebrow } = Astro.props;
const t = useTranslations(lang);
const stop = PASEO_STOPS[index];
const pad = (n: number) => String(n).padStart(2, "0");
const lenD = stopLengths(false)[index];
const lenM = stopLengths(true)[index];
---

<article
  id={stop.id}
  data-stop
  data-side={stop.side}
  style={`--len-d:${lenD};--len-m:${lenM}`}
  class="stop pointer-events-none relative flex flex-col justify-end"
>
  <img class="stop-still" src={stop.still} alt="" width="1600" height="900" loading="lazy" decoding="async" />
  <div class="stop-body">
    <p class="stop-counter">
      <span class="tabular-nums">{pad(index + 1)} / {pad(PASEO_STOPS.length)}</span>
      <span aria-hidden="true" class="stop-dot"></span>
      <span>{t(stop.place)}</span>
    </p>
    {eyebrow && <p class="stop-eyebrow">{eyebrow}</p>}
    <slot />
  </div>
</article>

<style>
  .stop {
    height: calc(var(--len-m) * 100vh);
    height: calc(var(--len-m) * 100svh);
  }

  @media (min-width: 768px) {
    .stop {
      height: calc(var(--len-d) * 100vh);
      height: calc(var(--len-d) * 100svh);
    }
  }

  .stop-still {
    display: none;
  }

  .stop-body {
    position: sticky;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    max-width: 36rem;
    padding: 6rem 1rem calc(1rem + env(safe-area-inset-bottom, 0px));
    /* The body is wider than its text (rail clearance); only the links take clicks so the rail stays reachable */
    pointer-events: none;
    color: #fff;
    text-shadow: 0 0 14px rgb(8 23 69 / 0.85), 0 1px 2px rgb(8 23 69 / 0.6);
  }

  @media (min-width: 768px) {
    .stop-body {
      max-width: 34rem;
      padding: 8rem 3rem 3.5rem;
    }

    .stop[data-side="right"] .stop-body {
      margin-left: auto;
    }

    .stop[data-side="left"] .stop-body {
      margin-right: auto;
    }
  }

  @media (min-width: 1024px) {
    /* Keep clear of the stop rail, whose current label opens to the left of its dot */
    .stop[data-side="right"] .stop-body {
      max-width: 37rem;
      padding-right: 9.5rem;
    }
  }

  @media (min-width: 1280px) {
    .stop[data-side="left"] .stop-body {
      padding-left: 5rem;
    }
  }

  .stop-counter {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-alivia-hero-text);
  }

  .stop-dot {
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 9999px;
    background: var(--color-alivia-secondary);
  }

  .stop-eyebrow {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-alivia-secondary);
  }

  /* While the scrub runs, only the current stop's text is shown (the inline script in
     HeroAnimation.astro sets data-hero-live; without it, or with reduced motion, all text stays visible). */
  :global(html[data-hero-live]) .stop-body > :global(*) {
    opacity: 0;
    transform: translateY(1.5rem);
    transition:
      opacity 500ms var(--ease-out),
      transform 500ms var(--ease-out);
  }

  :global(html[data-hero-live]) .stop.is-current .stop-body > :global(*),
  :global(html[data-hero-live]) .stop-body:focus-within > :global(*) {
    opacity: 1;
    transform: none;
    transition-duration: 700ms;
  }

  .stop.is-current .stop-body > :global(:nth-child(2)) { transition-delay: 50ms; }
  .stop.is-current .stop-body > :global(:nth-child(3)) { transition-delay: 100ms; }
  .stop.is-current .stop-body > :global(:nth-child(4)) { transition-delay: 150ms; }
  .stop.is-current .stop-body > :global(:nth-child(5)) { transition-delay: 200ms; }
  .stop.is-current .stop-body > :global(:nth-child(6)) { transition-delay: 250ms; }
  .stop.is-current .stop-body > :global(:nth-child(7)) { transition-delay: 300ms; }

  .stop-body :global(a) {
    pointer-events: auto;
  }

  :global(html[data-hero-live]) .stop:not(.is-current) .stop-body:not(:focus-within) :global(a) {
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-hero-live]) .stop-body > :global(*) {
      transform: none;
    }
  }

  /* Reduced motion / data saver: each stop becomes a still with its text stacked under it */
  :global(html[data-hero-still]) .stop {
    position: relative;
    height: auto;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    pointer-events: auto;
  }

  :global(html[data-hero-still]) .stop-still {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(html[data-hero-still]) .stop::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(8 23 69 / 0.85) 0%, rgb(8 23 69 / 0.45) 40%, transparent 70%);
  }

  :global(html[data-hero-still]) .stop-body {
    position: relative;
    z-index: 1;
    padding-top: calc(var(--nav-h, 6rem) + 2rem);
  }
</style>
