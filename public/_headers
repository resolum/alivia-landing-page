# Cloudflare static assets. Without these, every asset is served with max-age=0 and the browser
# revalidates (or re-downloads) all videos on each page, including when switching language.

# Hashed build output: the file name changes whenever the content does.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Media keeps its name across deploys, so it is cached for a week and then revalidated.
/hero/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/device/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/videos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/logo.ico
  Cache-Control: public, max-age=604800
