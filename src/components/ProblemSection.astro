---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const items = [
  {
    title: t("problem.card1.title"),
    desc: t("problem.card1.desc"),
    icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title: t("problem.card2.title"),
    desc: t("problem.card2.desc"),
    icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
  },
  {
    title: t("problem.card3.title"),
    desc: t("problem.card3.desc"),
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  },
];
---

<section id="problema" class="scroll-mt-24 py-20 sm:py-28 bg-white text-alivia-neutral-dark">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
      <div class="lg:col-span-6 lg:sticky lg:top-32 lg:self-start" data-reveal>
        <h2
          class="text-[2rem] leading-[1.1] sm:text-5xl font-semibold font-display mb-5 text-alivia-primary"
        >
          {t("problem.title")}
        </h2>
        <p class="text-base sm:text-lg text-alivia-neutral-gray leading-relaxed max-w-[52ch]">
          {t("problem.desc")}
        </p>
      </div>

      <ul
        class="lg:col-span-6 flex flex-col gap-3 sm:gap-4"
        aria-label={t("problem.cardListLabel")}
        data-reveal-group
      >
        {
          items.map((item) => (
            <li
              class="flex items-start gap-4 sm:gap-6 p-5 sm:p-7 rounded-2xl bg-alivia-surface-mist"
              data-reveal
            >
              <span class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-white text-alivia-secondary-dark flex items-center justify-center shrink-0">
                <svg
                  class="w-6 h-6"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                </svg>
              </span>
              <div class="min-w-0">
                <h3 class="text-lg sm:text-xl font-semibold text-alivia-primary mb-1.5">
                  {item.title}
                </h3>
                <p class="text-base text-alivia-neutral-blue leading-relaxed">
                  {item.desc}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="mt-14 sm:mt-20 rounded-3xl bg-alivia-primary text-white p-6 sm:p-10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6"
      data-reveal
    >
      <p class="text-lg sm:text-2xl font-display leading-snug max-w-3xl">
        {t("problem.closing")}
      </p>
      <a
        href="#como-funciona"
        class="press inline-flex items-center justify-center gap-2 px-6 min-h-12 rounded-lg text-base font-semibold bg-alivia-secondary text-alivia-primary hover:bg-alivia-secondary-dark hover:text-white focus-visible:ring-4 focus-visible:ring-alivia-secondary-medium touch-target shrink-0 w-full sm:w-auto"
      >
        {t("problem.cta")}
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
