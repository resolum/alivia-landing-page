---
import type { Lang } from "../i18n/ui";
import HeroAnimation from "./HeroAnimation.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---
<section id="que-es" class="relative w-full bg-alivia-primary-deep text-white [overflow-x:clip]">
  <HeroAnimation lang={lang} />
</section>
