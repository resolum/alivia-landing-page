---
interface Props {
  device: "light" | "door" | "window" | "microphone";
  class?: string;
}

const { device, class: className = "" } = Astro.props;
---

<svg
  class:list={["w-full h-auto", className]}
  viewBox="0 0 240 160"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="120" cy="80" r="62" fill="#DEF8F4" opacity="0.7"></circle>
  <circle cx="196" cy="34" r="10" fill="#C7EEE8" opacity="0.8"></circle>
  <circle cx="44" cy="130" r="7" fill="#C7EEE8" opacity="0.8"></circle>

  {
    device === "light" && (
      <Fragment>
        <path
          d="M120 12v22"
          stroke="#0F2A6B"
          stroke-width="3"
          stroke-linecap="round"
        />
        <path
          d="M86 52c0-18.8 15.2-34 34-34s34 15.2 34 34H86Z"
          fill="#FFFFFF"
          stroke="#0F2A6B"
          stroke-width="3"
          stroke-linejoin="round"
        />
        <path
          d="M102 52h36"
          stroke="#0F2A6B"
          stroke-width="3"
          stroke-linecap="round"
        />
        <circle cx="120" cy="72" r="16" fill="#2EC4B6" opacity="0.22" />
        <circle cx="120" cy="72" r="9" fill="#2EC4B6" />
        <g
          class="text-alivia-secondary-dark"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
        >
          <path d="M120 99v12"></path>
          <path d="M94 90l-9 8"></path>
          <path d="M146 90l9 8"></path>
          <path d="M82 72H70"></path>
          <path d="M158 72h12"></path>
        </g>
      </Fragment>
    )
  }

  {
    device === "door" && (
      <Fragment>
        <path
          d="M64 138V26h64v112"
          stroke="#0F2A6B"
          stroke-width="3"
          stroke-linejoin="round"
        />
        <path
          d="M128 32l52 10v96l-52-4V32Z"
          fill="#DEF8F4"
          stroke="#0F2A6B"
          stroke-width="3"
          stroke-linejoin="round"
        />
        <circle cx="168" cy="89" r="4" fill="#1E9184" />
        <g
          class="text-alivia-secondary-dark"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M188 68c7 7 10 14 10 21s-3 14-10 21"></path>
          <path d="M184 75l5-7 5 7"></path>
          <path d="M184 103l5 7 5-7"></path>
        </g>
      </Fragment>
    )
  }

  {
    device === "window" && (
      <Fragment>
        <rect
          x="56"
          y="28"
          width="128"
          height="104"
          rx="6"
          fill="#FFFFFF"
          stroke="#0F2A6B"
          stroke-width="3"
        />
        <path
          d="M120 28v104M56 80h128"
          stroke="#0F2A6B"
          stroke-width="3"
        />
        <rect x="62" y="34" width="52" height="40" rx="2" fill="#2EC4B6" opacity="0.2"></rect>
        <rect x="126" y="86" width="52" height="40" rx="2" fill="#2EC4B6" opacity="0.35"></rect>
        <path
          d="M120 96v22"
          stroke="#1E9184"
          stroke-width="3"
          stroke-linecap="round"
        />
        <path
          d="M114 101l6-6 6 6M114 114l6 6 6-6"
          stroke="#1E9184"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </Fragment>
    )
  }

  {
    device === "microphone" && (
      <Fragment>
        <rect
          x="96"
          y="20"
          width="48"
          height="80"
          rx="24"
          fill="#FFFFFF"
          stroke="#0F2A6B"
          stroke-width="3"
        />
        <path
          d="M120 34v52"
          stroke="#0F2A6B"
          stroke-width="2.5"
          stroke-linecap="round"
          opacity="0.45"
        />
        <path
          d="M80 78c0 22.1 17.9 40 40 40s40-17.9 40-40"
          stroke="#0F2A6B"
          stroke-width="3"
          stroke-linecap="round"
        />
        <path
          d="M120 118v18M102 136h36"
          stroke="#0F2A6B"
          stroke-width="3"
          stroke-linecap="round"
        />
        <g
          class="text-alivia-secondary-dark"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
        >
          <path d="M158 54c7 13 7 39 0 52"></path>
          <path d="M174 44c11 20 11 52 0 72"></path>
          <path d="M82 54c-7 13-7 39 0 52"></path>
        </g>
      </Fragment>
    )
  }
</svg>
