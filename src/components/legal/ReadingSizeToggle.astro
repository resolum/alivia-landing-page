---
import type { Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<button
  type="button"
  id="reading-size-toggle"
  aria-pressed="false"
  class="press inline-flex items-center gap-2 min-h-11 px-4 rounded-xl bg-white text-sm font-semibold text-alivia-primary hover:bg-alivia-primary-mist aria-pressed:bg-alivia-primary aria-pressed:text-white focus-visible:ring-2 focus-visible:ring-alivia-primary-medium"
>
  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7V5h16v2M9 19h6M12 5v14" />
  </svg>
  <span>{t("legal.comfortableReading")}</span>
</button>

<script>
  function setupReadingToggle() {
    const btn = document.getElementById("reading-size-toggle");
    const docContainer = document.getElementById("legal-doc-content");
    if (!btn || !docContainer) return;

    let isComfortable = false;
    try {
      isComfortable = localStorage.getItem("alivia_legal_font_size") === "comfortable";
    } catch {
      // Ignore storage errors
    }

    const applyState = (comfortable: boolean) => {
      btn.setAttribute("aria-pressed", String(comfortable));
      docContainer.classList.toggle("is-comfortable", comfortable);
    };

    applyState(isComfortable);

    btn.addEventListener("click", () => {
      isComfortable = !isComfortable;
      applyState(isComfortable);
      try {
        localStorage.setItem("alivia_legal_font_size", isComfortable ? "comfortable" : "default");
      } catch {
        // Ignore storage errors
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupReadingToggle);
  } else {
    setupReadingToggle();
  }
</script>
