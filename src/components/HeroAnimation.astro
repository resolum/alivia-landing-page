---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="hero-experience" class="relative w-full bg-alivia-surface text-white [overflow-x:clip]">
  <div id="scroll-track" class="relative w-full">
    <div
      id="hero-viewport"
      class="sticky top-0 w-full overflow-hidden flex items-center justify-center bg-alivia-surface"
    >
      <canvas
        id="hero-canvas"
        class="relative z-10 w-full h-full object-cover transition-opacity duration-500 opacity-100 hero-canvas-mask"
      ></canvas>
      <div
        class="absolute inset-0 z-15 bg-gradient-to-b from-alivia-primary-deep/40 via-transparent to-transparent pointer-events-none hero-canvas-mask"
      >
      </div>
      <div
        class="absolute inset-0 z-20 pointer-events-none flex items-center justify-center px-4 sm:px-6 max-md:pt-[calc(var(--nav-h,6rem)+0.5rem)]"
      >
        <div
          id="story-card-1"
          class="story-card opacity-100 translate-y-0 transition-all duration-500 ease-out text-center max-w-4xl"
        >
          <div
            class="story-card-inner p-4 sm:p-10 rounded-[22px] sm:rounded-3xl bg-[#040c29]/80 sm:bg-[#040c29]/50 border border-alivia-secondary/30 backdrop-blur-xl shadow-[0_12px_40px_rgba(0,0,0,0.5)] text-white drop-shadow-md relative overflow-hidden"
          >
            <div class="card-accent-bar absolute top-0 left-0 w-1.5 h-full bg-alivia-secondary md:hidden"></div>
            <div
              class="inline-flex items-center flex-wrap gap-1.5 sm:gap-2 px-3 sm:px-4 py-1 sm:py-1.5 rounded-full bg-alivia-primary/80 text-alivia-secondary-mint text-[clamp(0.7rem,2vw,0.75rem)] font-semibold tracking-normal sm:tracking-wider uppercase mb-2.5 sm:mb-5 border border-alivia-secondary-medium/40 shadow-sm max-w-full"
            >
              <span class="w-2 h-2 rounded-full bg-alivia-secondary animate-ping shrink-0"
              ></span>
              <span>{t("hero.badge")}</span>
            </div>
            <h1
              class="text-[clamp(1.5rem,4.5vw,2rem)] sm:text-5xl lg:text-6xl font-semibold font-display tracking-tight leading-[1.2] mb-2.5 sm:mb-5 text-white drop-shadow-md"
            >
              {t("hero.title")}
            </h1>

            <p
              class="text-[clamp(0.875rem,2.2vw,1rem)] text-alivia-hero-text max-w-3xl mx-auto leading-[1.48] mb-3.5 sm:mb-7 font-normal drop-shadow"
            >
              {t("hero.desc")}
            </p>

            <div
              class="flex flex-col sm:flex-row items-center justify-center gap-2.5 sm:gap-4 pointer-events-auto mb-3 sm:mb-6 w-full"
            >
              <a
                href="#planes"
                class="w-full sm:w-auto min-h-[48px] inline-flex items-center justify-center px-4 sm:px-[22px] py-2.5 sm:py-[12px] rounded-lg text-sm sm:text-base font-semibold bg-alivia-secondary text-alivia-primary hover:bg-alivia-secondary-dark hover:text-white transition-all shadow-lg shadow-alivia-secondary/20 focus-visible:ring-4 focus-visible:ring-alivia-secondary-medium touch-target text-center whitespace-normal leading-snug"
              >
                {t("hero.ctaPlans")}
              </a>
              <a
                href="#como-funciona"
                class="w-full sm:w-auto min-h-[48px] inline-flex items-center justify-center px-4 sm:px-[22px] py-2.5 sm:py-[12px] rounded-lg text-sm sm:text-base font-semibold bg-alivia-primary/80 text-white hover:bg-alivia-primary-medium transition-all border border-alivia-secondary-medium/30 focus-visible:ring-4 focus-visible:ring-alivia-primary-light touch-target backdrop-blur-sm text-center whitespace-normal leading-snug"
              >
                {t("hero.ctaHowItWorks")}
              </a>
            </div>

            <div
              class="flex items-center justify-center gap-2 text-xs uppercase tracking-widest text-alivia-secondary-medium font-semibold animate-bounce"
            >
              <span>{t("hero.scrollHint")}</span>
              <svg
                class="w-4 h-4 text-alivia-secondary shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
              </svg>
            </div>
          </div>
        </div>
        <div
          id="story-card-2"
          class="story-card opacity-0 translate-y-4 sm:translate-y-8 transition-all duration-700 ease-out md:absolute max-w-lg md:left-10 md:bottom-12"
        >
          <div
            class="story-card-inner p-4 sm:p-7 rounded-[22px] sm:rounded-2xl bg-[#040c29]/80 sm:bg-[#040c29]/60 border border-alivia-secondary/40 backdrop-blur-xl shadow-2xl text-white relative overflow-hidden group text-left"
          >
            <div class="card-accent-bar absolute top-0 left-0 w-1.5 h-full bg-alivia-secondary"></div>
            <div
              class="text-[clamp(0.7rem,2vw,0.75rem)] uppercase tracking-normal sm:tracking-widest font-semibold text-alivia-secondary-medium mb-1.5 flex items-center flex-wrap gap-2"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-alivia-secondary shrink-0"></span>
              <span>{t("hero.card2.badge")}</span>
            </div>
            <h2
              class="text-[clamp(1.35rem,4vw,1.75rem)] sm:text-2xl font-semibold font-display mb-2 text-white leading-tight"
            >
              {t("hero.card2.title")}
            </h2>
            <p class="text-[clamp(0.8125rem,2vw,0.9375rem)] sm:text-sm text-alivia-primary-mist leading-[1.48]">
              {t("hero.card2.desc")}
            </p>
          </div>
        </div>
        <div
          id="story-card-3"
          class="story-card opacity-0 translate-y-4 sm:translate-y-8 transition-all duration-700 ease-out md:absolute max-w-lg md:right-10 md:bottom-12 text-left"
        >
          <div
            class="story-card-inner p-4 sm:p-7 rounded-[22px] sm:rounded-2xl bg-[#040c29]/80 sm:bg-[#040c29]/60 border border-alivia-secondary/40 backdrop-blur-xl shadow-2xl text-white relative overflow-hidden text-left"
          >
            <div class="card-accent-bar absolute top-0 left-0 md:left-auto md:right-0 w-1.5 h-full bg-alivia-secondary md:bg-alivia-secondary-medium"></div>
            <div
              class="text-[clamp(0.7rem,2vw,0.75rem)] uppercase tracking-normal sm:tracking-widest font-semibold text-alivia-secondary-medium mb-1.5 flex items-center flex-wrap gap-2"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-alivia-secondary-medium shrink-0"></span>
              <span>{t("hero.card3.badge")}</span>
            </div>
            <h2
              class="text-[clamp(1.35rem,4vw,1.75rem)] sm:text-2xl font-semibold font-display mb-2 text-white leading-tight"
            >
              {t("hero.card3.title")}
            </h2>
            <p class="text-[clamp(0.8125rem,2vw,0.9375rem)] sm:text-sm text-alivia-primary-mist leading-[1.48]">
              {t("hero.card3.desc")}
            </p>
          </div>
        </div>
        <div
          id="story-card-4"
          class="story-card opacity-0 translate-y-4 sm:translate-y-8 transition-all duration-700 ease-out text-center max-w-xl"
        >
          <div
            class="story-card-inner p-4 sm:p-9 rounded-[22px] sm:rounded-3xl bg-[#040c29]/80 sm:bg-[#040c29]/65 border border-alivia-secondary/40 backdrop-blur-xl shadow-2xl text-white relative overflow-hidden"
          >
            <div class="card-accent-bar absolute top-0 left-0 w-1.5 h-full bg-alivia-secondary md:hidden"></div>
            <div
              class="inline-flex items-center flex-wrap gap-1.5 sm:gap-2 px-3 py-1 rounded-full bg-alivia-secondary/20 text-alivia-secondary-medium text-[clamp(0.7rem,2vw,0.75rem)] font-semibold uppercase tracking-normal sm:tracking-wider mb-2.5 sm:mb-4 border border-alivia-secondary/30 max-w-full"
            >
              <span>{t("hero.card4.badge")}</span>
            </div>
            <h2
              class="text-[clamp(1.5rem,4.5vw,2rem)] sm:text-3xl font-semibold font-display mb-2.5 sm:mb-3 text-white leading-tight"
            >
              {t("hero.card4.title")}
            </h2>
            <p
              class="text-alivia-primary-mist text-[clamp(0.8125rem,2vw,0.9375rem)] sm:text-sm mb-4 sm:mb-6 max-w-md mx-auto leading-[1.48]"
            >
              {t("hero.card4.desc")}
            </p>
            <div
              class="flex flex-col sm:flex-row items-center justify-center gap-2.5 sm:gap-3 pointer-events-auto w-full"
            >
              <a
                href="#dispositivos"
                class="w-full sm:w-auto min-h-[48px] inline-flex items-center justify-center px-6 py-2.5 sm:py-3 rounded-lg font-semibold text-sm bg-alivia-secondary text-alivia-primary hover:bg-alivia-secondary-dark hover:text-white shadow-lg shadow-alivia-secondary/20 transition-all duration-300 focus-visible:ring-4 focus-visible:ring-alivia-secondary-medium touch-target text-center whitespace-normal leading-snug"
              >
                {t("hero.card4.cta")}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initHeroAnimation } from '../scripts/heroAnimation';

  let cleanup: (() => void) | null = null;

  const start = () => {
    if (cleanup) cleanup();
    cleanup = initHeroAnimation();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }
  document.addEventListener('astro:page-load', start);
</script>

<style>
  #hero-experience {
    overflow-x: clip;
  }

  #scroll-track {
    height: 380vh;
    height: 380svh;
  }

  #hero-viewport {
    height: 100vh;
    height: 100svh;
    --hero-nav-h: var(--nav-h, 6rem);
  }

  @media (max-width: 767.98px) {
    #hero-canvas {
      object-fit: cover;
      object-position: center 30%;
    }

    .story-card {
      position: absolute !important;
      left: 1rem !important;
      right: 1rem !important;
      bottom: calc(1rem + env(safe-area-inset-bottom, 0px)) !important;
      top: auto !important;
      width: auto !important;
      max-width: calc(100% - 2rem) !important;
      max-height: calc(100vh - var(--nav-h, 6rem) - 1rem) !important;
      max-height: min(60vh, calc(100vh - var(--nav-h, 6rem) - 1rem)) !important;
      max-height: min(60svh, calc(100svh - var(--nav-h, 6rem) - 1rem)) !important;
      box-sizing: border-box !important;
      min-width: 0 !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
    }

    .story-card-inner {
      max-height: calc(100vh - var(--nav-h, 6rem) - 1rem) !important;
      max-height: min(60vh, calc(100vh - var(--nav-h, 6rem) - 1rem)) !important;
      max-height: min(60svh, calc(100svh - var(--nav-h, 6rem) - 1rem)) !important;
      box-sizing: border-box !important;
      min-width: 0 !important;
      overflow-y: hidden !important;
    }

    .story-card h1,
    .story-card h2,
    .story-card p,
    .story-card span {
      min-width: 0 !important;
      overflow-wrap: anywhere !important;
    }

    /* Si el titular o la primera tarjeta está en la parte alta en algún estado */
    #story-card-1.is-top,
    #story-card-1[data-state="top"],
    .story-card.is-top {
      top: 0 !important;
      bottom: auto !important;
      padding-top: calc(var(--nav-h, 6rem) + 0.5rem) !important;
    }

    #story-card-1.is-top h1,
    #story-card-1[data-state="top"] h1,
    .story-card.is-top h1 {
      padding-top: calc(var(--nav-h, 6rem) + 0.5rem) !important;
    }
  }

  @media (max-width: 932px) and (max-height: 500px) and (orientation: landscape) {
    .story-card {
      position: absolute !important;
      left: 1rem !important;
      right: auto !important;
      bottom: calc(0.5rem + env(safe-area-inset-bottom, 0px)) !important;
      top: auto !important;
      width: auto !important;
      max-width: 60% !important;
      max-height: 48vh !important;
      max-height: 48svh !important;
    }

    .story-card-inner {
      padding: 0.625rem 0.875rem !important;
      max-height: 48vh !important;
      max-height: 48svh !important;
    }

    .story-card h1,
    .story-card h2 {
      font-size: 1.1rem !important;
      line-height: 1.2 !important;
      margin-bottom: 0.2rem !important;
    }

    .story-card p {
      font-size: 0.72rem !important;
      line-height: 1.3 !important;
      margin-bottom: 0.3rem !important;
    }

    .story-card a {
      min-height: 40px !important;
      padding: 0.3rem 0.75rem !important;
      font-size: 0.75rem !important;
    }
  }

  .hero-canvas-mask {
    -webkit-mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 1) var(--mask-stop, 100%),
      rgba(0, 0, 0, 0) 100%
    );
    mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 1) var(--mask-stop, 100%),
      rgba(0, 0, 0, 0) 100%
    );
  }

  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #2ec4b6;
    cursor: pointer;
    box-shadow: 0 0 12px rgba(46, 196, 182, 0.8);
    transition: transform 0.15s ease;
  }
  input[type="range"]::-webkit-slider-thumb:hover {
    transform: scale(1.25);
  }
  input[type="range"]::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #2ec4b6;
    cursor: pointer;
    box-shadow: 0 0 12px rgba(46, 196, 182, 0.8);
    border: none;
  }
</style>
