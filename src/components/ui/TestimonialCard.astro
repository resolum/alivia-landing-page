---
import type { Testimonial } from '../../data/testimonials';
import type { Lang } from '../../i18n/ui';

interface Props {
  testimonial: Testimonial;
  lang?: Lang;
}
const { testimonial: tItem, lang = 'es' } = Astro.props;

const avatarBgClass: Record<string, string> = {
  primary:   'bg-alivia-primary text-white font-bold',
  secondary: 'bg-alivia-secondary-dark text-white font-bold',
  neutral:   'bg-alivia-primary-mist text-alivia-primary',
};

const anonymousBadgeLabel = lang === 'es' ? 'Identidad Reservada' : 'Anonymous';
---
<figure class="p-5 rounded-2xl bg-alivia-surface-mist flex flex-col gap-4">
  <blockquote class="text-[0.9375rem] text-alivia-neutral-dark leading-relaxed">{tItem.quote}</blockquote>

  <figcaption class="flex items-center gap-3">
    <div class={`w-10 h-10 rounded-full flex items-center justify-center text-sm shrink-0 ${avatarBgClass[tItem.avatarVariant]}`}>
      {tItem.initials ? (
        tItem.initials
      ) : (
        <svg
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
          ></path>
        </svg>
      )}
    </div>
    <div class="min-w-0">
      <p class="text-sm font-semibold text-alivia-primary">
        {tItem.name}
        {tItem.anonymous && (
          <span class="ml-1 text-xs font-medium text-alivia-neutral-blue bg-white px-2 py-0.5 rounded-full whitespace-nowrap">
            {anonymousBadgeLabel}
          </span>
        )}
      </p>
      <p class="text-[0.8125rem] text-alivia-neutral-blue">{tItem.location} · {tItem.role}</p>
    </div>
  </figcaption>
</figure>
