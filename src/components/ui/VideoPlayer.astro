---
import type {VideoCaptionTrack, VideoProvider} from "../../data/videos.ts";
interface Props {
  id: string;
  provider: VideoProvider;
  source: string;
  title: string;
  description?: string;
  poster?: string;
  captions?: VideoCaptionTrack[];
  fallbackTargetId?: string;
  fallbackMessage: string;
  fallbackLinkLabel?: string;
  externalUrl?: string;
  externalLabel?: string;
  playLabel?: string;
  clickLabel?: string;
  duration?: string;
  temporaryLabel?: string;
}

const {
  id,
  provider,
  source,
  title,
  description,
  poster,
  captions = [],
  fallbackTargetId,
  fallbackMessage,
  fallbackLinkLabel,
  externalUrl,
  externalLabel,
  playLabel = "Reproducir video",
  clickLabel,
  duration,
  temporaryLabel,
} = Astro.props;

const descriptionId = description ? `${id}-description` : undefined;
const externalHref =
  externalUrl ?? (provider === "youtube" ? `https://www.youtube.com/watch?v=${source}` : source);
---

<div
  class="video-player w-full"
  data-video-player
  data-provider={provider}
  data-source={source}
  data-title={title}
  data-fallback-target={fallbackTargetId}
>
  {
    description && (
      <p id={descriptionId} class="sr-only">
        {description}
      </p>
    )
  }

  <div
    class="relative aspect-video w-full overflow-hidden bg-alivia-primary-deep"
    data-video-frame
  >
    {provider === "youtube" ? (
      <button
        type="button"
        class="group absolute inset-0 flex flex-col items-center justify-center gap-3 p-6 text-center text-white transition-colors hover:bg-alivia-primary/20 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-inset focus-visible:ring-alivia-secondary-medium"
        data-video-launch
        aria-label={`${playLabel}: ${title}`}
      >
        <span class="flex h-20 w-20 items-center justify-center rounded-full bg-alivia-secondary text-alivia-primary shadow-xl transition-transform group-hover:scale-110">
          <svg
            class="ml-1 h-10 w-10"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M8 5v14l11-7z" />
          </svg>
        </span>
        <span class="text-lg font-semibold font-display">{playLabel}</span>
        {clickLabel && <span class="text-sm text-white/70">{clickLabel}</span>}
        <span class="text-xs font-medium uppercase tracking-widest text-alivia-secondary-medium">
          {title}
          {duration ? ` · ${duration}` : ""}
        </span>
        {
          temporaryLabel && (
            <span class="rounded-full border border-alivia-secondary-medium/40 bg-alivia-primary/70 px-3 py-1 text-[11px] font-semibold text-alivia-secondary-mint">
              {temporaryLabel}
            </span>
          )
        }
      </button>
    ) : (
      <video
        id={id}
        class="h-full w-full object-cover"
        controls
        preload="metadata"
        playsinline
        poster={poster}
        aria-label={title}
        aria-describedby={descriptionId}
        data-video-element
      >
        <source src={source} type="video/mp4" />
        {captions.map((track) => (
          <track
            kind="captions"
            src={track.src}
            srclang={track.srcLang}
            label={track.label}
            default={track.default}
          />
        ))}
        <p>
          {fallbackMessage}{" "}
          <a href={externalHref} target="_blank" rel="noopener noreferrer">
            {externalLabel ?? externalHref}
          </a>
        </p>
      </video>
    )}

    <div
      class="absolute inset-0 hidden flex-col items-center justify-center gap-4 bg-alivia-primary p-6 text-center text-white"
      data-video-embed
      aria-hidden="true"
    >
    </div>
  </div>

  {
    provider === "youtube" && externalHref && externalLabel && (
      <p class="mt-3 text-center text-xs text-alivia-primary-light">
        <a
          href={externalHref}
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-2 transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-alivia-secondary-medium"
        >
          {externalLabel}
        </a>
      </p>
    )
  }

  <div
    class="hidden flex flex-col items-center justify-center gap-4 rounded-b-2xl bg-alivia-primary/90 p-6 text-center text-white sm:p-8"
    data-video-error
    role="status"
    aria-live="polite"
  >
    <svg
      class="h-10 w-10 text-alivia-secondary"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"
      />
    </svg>
    <p class="max-w-2xl text-sm leading-relaxed sm:text-base">{fallbackMessage}</p>
    <div class="flex flex-wrap items-center justify-center gap-3">
      {
        fallbackTargetId && fallbackLinkLabel && (
          <a
            href={`#${fallbackTargetId}`}
            class="inline-flex items-center justify-center rounded-lg bg-alivia-secondary px-4 py-2.5 text-sm font-semibold text-alivia-primary transition-colors hover:bg-alivia-secondary-medium focus-visible:ring-4 focus-visible:ring-alivia-secondary-medium"
          >
            {fallbackLinkLabel}
          </a>
        )
      }
      {
        externalHref && externalLabel && (
          <a
            href={externalHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-lg border border-white/30 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-white/10 focus-visible:ring-4 focus-visible:ring-alivia-secondary-medium"
          >
            {externalLabel}
          </a>
        )
      }
    </div>
  </div>
</div>

<script>
  type VideoPlayerElement = HTMLElement & {
    dataset: DOMStringMap & {
      provider?: VideoProvider;
      source?: string;
      title?: string;
      fallbackTarget?: string;
    };
  };

  type VideoProvider = "file" | "youtube";

  const revealTextAlternative = (player: VideoPlayerElement) => {
    const targetId = player.dataset.fallbackTarget;
    if (!targetId) return;

    const target = document.getElementById(targetId);
    if (!target) return;

    target.classList.remove("hidden");
    target.removeAttribute("hidden");
    target.classList.add("ring-2", "ring-alivia-secondary");

    const toggle = document.querySelector<HTMLButtonElement>(
      `[aria-controls="${targetId}"]`,
    );
    if (toggle) {
      toggle.setAttribute("aria-expanded", "true");
      const hideText = toggle.dataset.hideText;
      if (hideText) toggle.textContent = hideText;
    }
  };

  const setupPlayer = (player: VideoPlayerElement) => {
    if (player.dataset.initialized === "true") return;
    player.dataset.initialized = "true";

    const provider = player.dataset.provider;
    const frame = player.querySelector<HTMLElement>("[data-video-frame]");
    const errorPanel = player.querySelector<HTMLElement>("[data-video-error]");
    const embed = player.querySelector<HTMLElement>("[data-video-embed]");

    const showError = () => {
      frame?.classList.add("hidden");
      embed?.classList.add("hidden");
      errorPanel?.classList.remove("hidden");
      revealTextAlternative(player);
    };

    if (provider === "youtube") {
      const launch = player.querySelector<HTMLButtonElement>("[data-video-launch]");
      const source = player.dataset.source ?? "";
      const title = player.dataset.title ?? "";
      if (!launch || !embed) return;

      launch.addEventListener("click", () => {
        if (!navigator.onLine) {
          showError();
          return;
        }

        const iframe = document.createElement("iframe");
        iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(source)}?rel=0&modestbranding=1&autoplay=1`;
        iframe.title = title;
        iframe.className = "h-full w-full";
        iframe.allow =
          "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        iframe.allowFullscreen = true;
        iframe.loading = "lazy";

        const timeout = window.setTimeout(showError, 12000);
        iframe.addEventListener("load", () => window.clearTimeout(timeout), {
          once: true,
        });

        embed.replaceChildren(iframe);
        embed.classList.remove("hidden");
        embed.classList.add("flex");
        embed.setAttribute("aria-hidden", "false");
        launch.classList.add("hidden");
        launch.setAttribute("aria-hidden", "true");
        iframe.focus();

        window.addEventListener("offline", showError, { once: true });
      });

      return;
    }

    const video = player.querySelector<HTMLVideoElement>("[data-video-element]");
    if (!video) return;

    video.addEventListener("error", showError);
    video.querySelector("source")?.addEventListener("error", showError);
    video.addEventListener("loadeddata", () => {
      errorPanel?.classList.add("hidden");
      frame?.classList.remove("hidden");
    });

    if (video.error) showError();
  };

  const initPlayers = () => {
    document
      .querySelectorAll<VideoPlayerElement>("[data-video-player]")
      .forEach(setupPlayer);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPlayers);
  } else {
    initPlayers();
  }
  document.addEventListener("astro:page-load", initPlayers);
</script>
