---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import {
  getTestimonialsColUp,
  getTestimonialsColDown,
} from "../data/testimonials";
import TestimonialCard from "./ui/TestimonialCard.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const colUp = getTestimonialsColUp(lang);
const colDown = getTestimonialsColDown(lang);
---

<section
  id="testimonios"
  class="scroll-mt-24 py-20 sm:py-28 bg-white text-alivia-neutral-dark overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <div class="lg:col-span-6 lg:order-2 flex flex-col gap-5" data-reveal>
        <h2
          class="text-[2rem] leading-[1.1] sm:text-5xl lg:text-[2.75rem] xl:text-5xl font-semibold font-display text-alivia-primary"
        >
          {t("testimonials.title")}
        </h2>
        <p
          class="text-base sm:text-lg text-alivia-neutral-blue leading-relaxed"
        >
          {t("testimonials.desc")}
        </p>
        <div class="flex items-start gap-2 text-sm text-alivia-neutral-blue">
          <svg
            class="w-4 h-4 mt-0.5 text-alivia-secondary-dark shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
            ></path>
          </svg>
          {t("testimonials.privacyNote")}
        </div>
      </div>

      <div
        id="testimonial-marquee"
        class="lg:col-span-6 lg:order-1 flex gap-4 sm:gap-5 h-[480px] sm:h-[560px] overflow-hidden relative marquee-mask"
      >
        <div class="marquee-col marquee-up flex-1 min-w-0 flex flex-col">
          <div class="flex flex-col gap-4 sm:gap-5 pb-4 sm:pb-5">
            {
              colUp.map((tItem) => (
                <TestimonialCard testimonial={tItem} lang={lang} />
              ))
            }
            {
              colDown.map((tItem) => (
                <div class="sm:hidden">
                  <TestimonialCard testimonial={tItem} lang={lang} />
                </div>
              ))
            }
          </div>
          <div
            class="flex flex-col gap-4 sm:gap-5 pb-4 sm:pb-5"
            aria-hidden="true"
          >
            {
              colUp.map((tItem) => (
                <TestimonialCard testimonial={tItem} lang={lang} />
              ))
            }
            {
              colDown.map((tItem) => (
                <div class="sm:hidden">
                  <TestimonialCard testimonial={tItem} lang={lang} />
                </div>
              ))
            }
          </div>
        </div>
        <div
          class="marquee-col marquee-down hidden sm:flex flex-1 min-w-0 flex-col"
        >
          <div class="flex flex-col gap-4 sm:gap-5 pb-4 sm:pb-5">
            {
              colDown.map((tItem) => (
                <TestimonialCard testimonial={tItem} lang={lang} />
              ))
            }
          </div>
          <div
            class="flex flex-col gap-4 sm:gap-5 pb-4 sm:pb-5"
            aria-hidden="true"
          >
            {
              colDown.map((tItem) => (
                <TestimonialCard testimonial={tItem} lang={lang} />
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Pause the CSS marquee while it is off screen so it costs nothing there
  const marquee = document.getElementById("testimonial-marquee");
  if (marquee && "IntersectionObserver" in window) {
    new IntersectionObserver(([entry]) => {
      marquee.classList.toggle("is-offscreen", !entry.isIntersecting);
    }).observe(marquee);
  }
</script>

<style>
  /* Fade the conveyor's edges into the section instead of overlaying gradient boxes */
  .marquee-mask {
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 12%,
      #000 88%,
      transparent
    );
    mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 12%,
      #000 88%,
      transparent
    );
  }

  /* CSS animation runs on the compositor: smooth even while the page is busy */
  @media (prefers-reduced-motion: no-preference) {
    .marquee-up {
      animation: marquee-up 70s linear infinite;
    }
    .marquee-down {
      animation: marquee-down 70s linear infinite;
    }
  }

  /* Reduced motion: the column becomes a normal scrollable list */
  @media (prefers-reduced-motion: reduce) {
    #testimonial-marquee {
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .marquee-col > [aria-hidden="true"] {
      display: none;
    }
  }

  #testimonial-marquee.is-offscreen .marquee-col {
    animation-play-state: paused;
  }

  @media (hover: hover) and (pointer: fine) {
    #testimonial-marquee:hover .marquee-col {
      animation-play-state: paused;
    }
  }

  @keyframes marquee-up {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-50%);
    }
  }

  @keyframes marquee-down {
    from {
      transform: translateY(-50%);
    }
    to {
      transform: translateY(0);
    }
  }
</style>
