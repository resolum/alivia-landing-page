---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import { getNavLinks } from "../data/nav";
import { APP_URLS } from "../data/apps";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { Image } from "astro:assets";
import logoImg from "../assets/logo.webp";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const navLinks = getNavLinks(lang);

const loginOptions = [
  {
    href: APP_URLS.user,
    label: t("nav.loginUser"),
    desc: t("nav.loginUserDesc"),
    icon: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z",
  },
  {
    href: APP_URLS.admin,
    label: t("nav.loginAdmin"),
    desc: t("nav.loginAdminDesc"),
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  },
];
---

<header
  id="main-header"
  data-solid-from="problema"
  data-solid="false"
  class="fixed top-0 left-0 right-0 z-50 text-white transition-all duration-200 py-4 bg-transparent border-b border-transparent data-[solid=true]:bg-alivia-primary-deep/95 data-[solid=true]:backdrop-blur-xl data-[solid=true]:shadow-2xl data-[solid=true]:border-alivia-primary-medium/50 data-[solid=true]:py-2"
>
  <script is:inline>
    (function () {
      const header = document.getElementById("main-header");
      if (!header) return;
      const triggerId = header.getAttribute("data-solid-from") || "problema";
      const section = document.getElementById(triggerId);
      if (!section) return;
      const isSolid = section.getBoundingClientRect().top <= header.offsetHeight;
      header.setAttribute("data-solid", isSolid ? "true" : "false");
    })();
  </script>
  <div
    class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4 lg:gap-6"
  >
    <div class="flex items-center gap-3 shrink-0">
      <a
        href="#"
        class="flex items-center gap-2 group focus-visible:ring-2 focus-visible:ring-alivia-secondary-medium rounded-lg p-1"
        aria-label={t("nav.logoAriaLabel")}
      >
        <Image
          src={logoImg}
          alt="Alivia Logo"
          class="w-14 h-14 sm:w-20 sm:h-20 object-contain group-hover:scale-105 transition-transform duration-200 ease-[var(--ease-out)]"
        />
        <span
          class="text-2xl font-bold tracking-tight text-white font-display group-hover:text-alivia-secondary transition-colors"
        >
          Alivia
        </span>
      </a>
      <span
        class="hidden 2xl:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium bg-alivia-primary-medium/40 backdrop-blur-md text-alivia-secondary-mint border border-alivia-secondary-medium/30 shrink-0"
      >
        <svg
          class="w-3.5 h-3.5 text-alivia-secondary"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        {t("nav.a11yBadge")}
      </span>
    </div>
    <nav
      class="hidden xl:flex items-center gap-3.5 2xl:gap-6 text-xs 2xl:text-sm font-semibold tracking-wide text-white/90 whitespace-nowrap"
      aria-label={t("nav.mainNavLabel")}
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="nav-link relative py-1 px-1.5 text-alivia-primary-mist hover:text-alivia-secondary aria-[current=true]:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
      <div class="hidden xl:block">
        <LanguageSwitcher currentLang={lang} />
      </div>
      <div id="login-dropdown" class="relative hidden xl:block">
        <button
          id="login-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="login-menu"
          aria-label={t("nav.loginAriaLabel")}
          class="press inline-flex items-center gap-2 px-4 sm:px-5 py-2.5 rounded-full text-sm font-semibold bg-alivia-secondary text-alivia-primary-deep hover:bg-alivia-secondary-medium focus-visible:ring-4 focus-visible:ring-alivia-secondary-medium touch-target whitespace-nowrap"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"
            ></path>
          </svg>
          <span>{t("nav.login")}</span>
          <svg class="login-chevron w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
        <div
          id="login-menu"
          hidden
          aria-label={t("nav.loginMenuLabel")}
          class="absolute right-0 top-full mt-2 w-72 rounded-2xl bg-alivia-primary-deep p-2 shadow-2xl ring-1 ring-white/15"
        >
          {
            loginOptions.map((option) => (
              <a
                href={option.href}
                target="_blank"
                rel="noopener noreferrer"
                class="login-option flex items-start gap-3 rounded-xl px-3 py-2.5 text-white hover:bg-white/10 focus-visible:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-alivia-secondary"
              >
                <span class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-lg bg-alivia-secondary/15 text-alivia-secondary">
                  <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={option.icon}></path>
                  </svg>
                </span>
                <span class="flex flex-col">
                  <span class="text-sm font-semibold">{option.label}</span>
                  <span class="text-xs text-alivia-primary-light">{option.desc}</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
      <button
        id="mobile-menu-toggle"
        type="button"
        class="relative xl:hidden p-2.5 rounded-lg text-white hover:bg-white/10 transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary touch-target"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t("nav.mobileMenuToggle")}
      >
        <svg
          id="menu-icon-open"
          class="menu-icon w-6 h-6 block"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="menu-icon-close"
          class="menu-icon absolute top-2.5 left-2.5 w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>
  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu"
    class="hidden xl:hidden bg-alivia-primary-deep border-b border-white/10 px-6 pt-4 pb-[calc(1.5rem+env(safe-area-inset-bottom,0px))] max-h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain"
    data-lenis-prevent
    aria-label={t("nav.mobileMenuLabel")}
  >
    <div class="flex flex-col gap-4 text-base font-medium text-white/90">
      <div class="flex items-center justify-between mb-2">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded bg-alivia-primary-medium/50 text-xs font-semibold text-alivia-secondary-medium w-fit"
        >
          {t("nav.a11yBadgeMobile")}
        </div>
        <LanguageSwitcher currentLang={lang} />
      </div>
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link flex items-center min-h-12 py-2 border-b border-white/10 hover:text-alivia-secondary active:text-alivia-secondary transition-colors"
          >
            {link.label}
          </a>
        ))
      }
      <div class="mt-2 flex flex-col gap-2" role="group" aria-label={t("nav.loginAriaLabel")}>
        <p class="text-xs font-semibold tracking-wider text-alivia-secondary-medium uppercase">{t("nav.login")}</p>
        {
          loginOptions.map((option, i) => (
            <a
              href={option.href}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[
                "press mobile-nav-link inline-flex items-center justify-center gap-2 px-5 min-h-12 rounded-full text-base font-semibold",
                i === 0
                  ? "bg-alivia-secondary text-alivia-primary-deep hover:bg-alivia-secondary-medium"
                  : "text-white ring-1 ring-white/30 hover:bg-white/10",
              ]}
            >
              <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={option.icon}></path>
              </svg>
              <span>{option.label}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</header>

<script>
  import { initNavBar } from "../scripts/navBar";

  let cleanup: (() => void) | null = null;

  const start = () => {
    if (cleanup) cleanup();
    cleanup = initNavBar();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start);
  } else {
    start();
  }
  document.addEventListener("astro:page-load", start);
</script>

<style>
  #main-header {
    transition:
      background-color 200ms ease,
      padding 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease,
      opacity 400ms var(--ease-out),
      transform 400ms var(--ease-out);
  }

  #main-header[data-solid="true"] {
    background-color: color-mix(in srgb, var(--color-alivia-primary-deep) 95%, transparent);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 10px 30px -18px rgba(8, 23, 69, 0.6);
    border-bottom-width: 1px;
    border-color: color-mix(in srgb, var(--color-alivia-primary-medium) 50%, transparent);
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  #main-header[data-solid="false"] {
    background-color: transparent;
    border-color: transparent;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  /* Drawer drops from the bar it belongs to; opened occasionally, so a short entrance */
  #mobile-menu:not(.hidden) {
    animation: menu-in 240ms var(--ease-out);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  /* Close is quicker and travels less than the open: it gets out of the way */
  #mobile-menu.is-closing {
    animation: menu-out 150ms var(--ease-out) forwards;
  }

  @keyframes menu-out {
    to {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  /* Sign in menu: grows from the button it belongs to */
  #login-menu:not([hidden]) {
    transform-origin: top right;
    animation: login-in 160ms var(--ease-out);
  }

  @keyframes login-in {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.97);
    }
  }

  .login-chevron {
    transition: transform 200ms var(--ease-out);
  }

  #login-toggle[aria-expanded="true"] .login-chevron {
    transform: rotate(180deg);
  }

  /* Burger ⇄ close: both icons stay mounted and cross-fade */
  .menu-icon {
    transition:
      opacity 200ms cubic-bezier(0.2, 0, 0, 1),
      transform 200ms cubic-bezier(0.2, 0, 0, 1),
      filter 200ms cubic-bezier(0.2, 0, 0, 1);
  }

  #mobile-menu-toggle[aria-expanded="false"] #menu-icon-close,
  #mobile-menu-toggle[aria-expanded="true"] #menu-icon-open {
    opacity: 0;
    transform: scale(0.25);
    filter: blur(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    #main-header {
      transition: none !important;
    }
    #mobile-menu:not(.hidden),
    #login-menu:not([hidden]) {
      animation-name: menu-fade;
    }
    #mobile-menu.is-closing {
      animation-name: menu-fade-out;
    }
    @keyframes menu-fade-out {
      to {
        opacity: 0;
      }
    }
    .menu-icon {
      transition: opacity 150ms ease;
    }
    #mobile-menu-toggle[aria-expanded="false"] #menu-icon-close,
    #mobile-menu-toggle[aria-expanded="true"] #menu-icon-open {
      transform: none;
      filter: none;
    }
    @keyframes menu-fade {
      from {
        opacity: 0;
      }
    }
  }
</style>
