---
import Layout from "../../layouts/Layout.astro";
import type { Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";
import LanguageSwitcher from "../LanguageSwitcher.astro";
import { companyInfo } from "../../data/company";
import logoImg from "../../assets/logo.png";
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  lang: Lang;
  activeTab: "privacy" | "terms";
}

const { title, description, lang, activeTab } = Astro.props;
const t = useTranslations(lang);
const homeHref = lang === "es" ? "/es/" : "/";
const privacyHref = lang === "es" ? "/es/politica-de-privacidad" : "/privacy-policy";
const termsHref = lang === "es" ? "/es/terminos-y-condiciones" : "/terms-and-conditions";
---

<Layout title={title} description={description} lang={lang}>
  <a href="#main-content" class="skip-to-content">{t("legal.skipLink")}</a>
  <header class="sticky top-0 z-40 bg-alivia-primary-deep/95 backdrop-blur-md text-white border-b border-white/10 py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <a href={homeHref} class="flex items-center gap-2 group focus-visible:ring-2 focus-visible:ring-alivia-secondary rounded-lg p-1">
          <Image src={logoImg} alt="Alivia Logo" class="w-8 h-8 object-contain" />
          <span class="text-xl font-bold font-display group-hover:text-alivia-secondary transition-colors">Alivia</span>
        </a>
        <a href={homeHref} class="hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold text-alivia-primary-mist hover:text-alivia-secondary transition-colors px-2 py-1">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
          {t("legal.backToHome")}
        </a>
      </div>
      <nav class="legal-tab-nav relative inline-flex items-center p-1 rounded-2xl bg-[#09153b]/80 border border-white/20 shadow-md text-xs sm:text-sm font-semibold max-w-full" data-active-tab={activeTab} aria-label="Documentos legales">
        <span
          class:list={[
            "legal-tab-pill absolute top-1 bottom-1 rounded-xl bg-alivia-secondary shadow-md transition-all duration-300 ease-[cubic-bezier(.4,0,.2,1)] pointer-events-none",
            activeTab === "privacy" ? "left-1 w-[calc(50%-4px)]" : "left-[calc(50%+2px)] w-[calc(50%-4px)]",
          ]}
        ></span>
        <a
          href={privacyHref}
          data-tab="privacy"
          aria-current={activeTab === "privacy" ? "page" : undefined}
          class:list={[
            "relative z-10 px-3 sm:px-4 py-2 rounded-xl transition-colors duration-300 touch-target flex items-center justify-center font-bold text-center whitespace-nowrap",
            activeTab === "privacy" ? "text-alivia-primary-deep" : "text-white/85 hover:text-white",
          ]}
        >
          {t("legal.privacyTab")}
        </a>
        <a
          href={termsHref}
          data-tab="terms"
          aria-current={activeTab === "terms" ? "page" : undefined}
          class:list={[
            "relative z-10 px-3 sm:px-4 py-2 rounded-xl transition-colors duration-300 touch-target flex items-center justify-center font-bold text-center whitespace-nowrap",
            activeTab === "terms" ? "text-alivia-primary-deep" : "text-white/85 hover:text-white",
          ]}
        >
          {t("legal.termsTab")}
        </a>
      </nav>
      <div class="flex items-center gap-3">
        <LanguageSwitcher currentLang={lang} />
      </div>
    </div>
  </header>

  <div class="bg-alivia-primary text-white text-xs py-2.5 border-b border-alivia-primary-medium">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-wrap items-center justify-center sm:justify-start gap-4 sm:gap-6 text-alivia-primary-mist">
      {companyInfo.complianceBadges.wcag && (
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-alivia-secondary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          {t("legal.badgeWcag")}
        </span>
      )}
      {companyInfo.complianceBadges.localEncryption && (
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-alivia-secondary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" /></svg>
          {t("legal.badgeEncryption")}
        </span>
      )}
    </div>
  </div>

  <main id="main-content" class="min-h-screen bg-alivia-surface text-alivia-neutral-dark py-10 sm:py-16">
    <slot />
  </main>

  <footer class="bg-alivia-primary-deep text-alivia-primary-mist text-xs py-8 border-t border-alivia-primary-medium">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div>
        <p class="font-semibold text-white">{companyInfo.legalName}</p>
        <p class="mt-1 text-alivia-primary-light">© 2026 {companyInfo.tradeName}. Todos los derechos reservados.</p>
      </div>
      <a href={homeHref} class="hover:text-alivia-secondary transition-colors underline">{t("legal.backToHome")}</a>
    </div>
  </footer>

  <script src="../../scripts/legal/legalTabSlide.ts"></script>
</Layout>
