---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import PaseoStop from "./PaseoStop.astro";
import { PASEO_STOPS } from "../data/paseo";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const clipNumbers = [1, 2, 3, 4, 5, 6];

const title = "mt-3 max-w-xl text-[1.625rem] leading-[1.1] font-semibold font-display text-white sm:text-4xl lg:text-5xl";
const body = "mt-2.5 max-w-md text-[0.8125rem] leading-[1.45] text-alivia-hero-text sm:mt-3 sm:text-base lg:text-lg";
const btnPrimary =
  "press min-h-[44px] sm:min-h-[48px] inline-flex items-center justify-center rounded-lg px-5 py-2 sm:py-2.5 text-base font-semibold leading-snug text-center bg-alivia-secondary text-alivia-primary hover:bg-alivia-secondary-medium focus-visible:ring-4 focus-visible:ring-alivia-secondary-medium touch-target";
const btnSecondary =
  "press min-h-[44px] sm:min-h-[48px] inline-flex items-center justify-center rounded-lg px-5 py-2 sm:py-2.5 text-base font-semibold leading-snug text-center bg-alivia-primary text-white ring-1 ring-white/30 hover:bg-alivia-primary-medium focus-visible:ring-4 focus-visible:ring-alivia-primary-light touch-target";
const link =
  "mt-5 inline-flex min-h-[44px] items-center gap-2 text-sm font-semibold text-alivia-secondary underline-offset-4 hover:underline focus-visible:ring-4 focus-visible:ring-alivia-secondary-medium rounded";
const pill =
  "rounded-full bg-alivia-primary-deep/60 px-3 py-1 text-xs font-medium text-alivia-hero-text ring-1 ring-white/20";
---

<!-- Reduced motion / data saver => stills; otherwise the scrub runs. Decided before first paint. -->
<script is:inline>
  (function () {
    var c = navigator.connection;
    var root = document.documentElement;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches || (c && (c.saveData || /(^|-)2g$/.test(c.effectiveType || "")))) {
      root.dataset.heroStill = "1";
    } else {
      root.dataset.heroLive = "1";
    }
  })();
</script>
<noscript><style>#hero-media{opacity:1!important}</style></noscript>

<section
  id="recorrido"
  data-world
  aria-label={t("paseo.label")}
  class="relative w-full bg-alivia-surface text-white [overflow-x:clip]"
>
  <div id="scroll-track" class="relative w-full">
    <!-- Fixed stage: the six clips fill the screen. Each clip's first frame is its own poster. -->
    <div
      id="hero-viewport"
      data-stage
      data-side="right"
      class="sticky top-0 w-full overflow-hidden bg-alivia-primary-deep"
    >
      <div id="hero-media" aria-hidden="true" class="absolute inset-0 z-10 hero-canvas-mask">
        {
          clipNumbers.map((n) => (
            <video
              class="hero-video"
              muted
              playsinline
              preload="none"
              disablepictureinpicture
              disableremoteplayback
              tabindex="-1"
              poster={`/hero/clips/poster${n}.webp`}
            />
          ))
        }
      </div>

      <!-- Reading veils in the page's deep blue: top, bottom, and the side the text sits on -->
      <div aria-hidden="true" class="veil veil-top"></div>
      <div aria-hidden="true" class="veil veil-bottom"></div>
      <div aria-hidden="true" class="veil veil-left"></div>
      <div aria-hidden="true" class="veil veil-right"></div>

      <!-- Stop rail (desktop) -->
      <nav aria-label={t("paseo.rail")} id="paseo-rail" class="absolute top-1/2 right-6 z-30 hidden -translate-y-1/2 lg:block xl:right-8">
        <ol class="relative flex flex-col items-end gap-4">
          <span aria-hidden="true" class="absolute top-3 right-1 bottom-3 w-px translate-x-1/2 bg-white/25">
            <span data-rail-fill class="absolute inset-0 origin-top scale-y-0 bg-alivia-secondary"></span>
          </span>
          {
            PASEO_STOPS.map((stop, i) => (
              <li>
                <a
                  href={`#${stop.id}`}
                  data-goto={i}
                  aria-current={i === 0 ? "true" : "false"}
                  class="rail-link group flex h-6 items-center gap-3 rounded-full focus-visible:ring-4 focus-visible:ring-alivia-secondary-medium"
                >
                  <span class="rail-label rounded-full bg-alivia-primary-deep/80 px-3 py-1 text-xs whitespace-nowrap text-white ring-1 ring-white/20">
                    {t(stop.place)}
                  </span>
                  <span class="relative grid size-2 place-items-center">
                    <span class="rail-dot size-2 rounded-full bg-white/60" />
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <p
        data-paseo-hint
        aria-hidden="true"
        class="absolute right-8 bottom-8 z-30 hidden items-center gap-3 text-xs font-medium tracking-widest text-alivia-hero-text uppercase lg:flex"
      >
        {t("paseo.hint")}
        <span class="hint-line relative block h-8 w-px overflow-hidden bg-white/25"></span>
      </p>
    </div>

    <!-- Stops: each one leaves its text at the bottom while the walk goes on -->
    <div id="paseo-stops" class="relative z-20 pointer-events-none">
      <PaseoStop lang={lang} index={0} eyebrow={t("paseo.eyebrow.0")}>
        <h1 class="mt-2 max-w-xl text-[1.5rem] leading-[1.08] font-semibold font-display text-white sm:text-4xl lg:text-5xl">
          {t("hero.title")}
        </h1>
        <p class={body}>{t("hero.desc")}</p>
        <div class="mt-4 flex w-full flex-col gap-2 sm:mt-5 sm:w-auto sm:flex-row sm:gap-3">
          <a href="#planes" data-magnetic class={btnPrimary}>{t("hero.ctaPlans")}</a>
          <a href="#como-funciona" data-magnetic class={btnSecondary}>{t("hero.ctaHowItWorks")}</a>
        </div>
        <ul class="mt-3 flex flex-wrap gap-1.5 sm:mt-4 sm:gap-2" aria-label={t("paseo.eyebrow.0")}>
          <li class={pill}>{t("paseo.pill.local")}</li>
          <li class={pill}>{t("paseo.pill.cameras")}</li>
          <li class={pill}>{t("legal.badgeWcag")}</li>
        </ul>
      </PaseoStop>

      <PaseoStop lang={lang} index={1} eyebrow={t("paseo.eyebrow.1")}>
        <h2 class={title}>{t("problem.title")}</h2>
        <p class={body}>{t("paseo.stop1.desc")}</p>
        <ul class="mt-4 flex max-w-md flex-col gap-2">
          {
            ["problem.card1.title", "problem.card2.title", "problem.card3.title"].map((k) => (
              <li class="flex items-start gap-3 text-[0.9375rem] font-medium leading-snug text-white sm:text-base">
                <span aria-hidden="true" class="mt-[0.45em] size-1.5 shrink-0 rounded-full bg-alivia-secondary" />
                {t(k as never)}
              </li>
            ))
          }
        </ul>
      </PaseoStop>

      <PaseoStop lang={lang} index={2} eyebrow={t("paseo.eyebrow.2")}>
        <h2 class={title}>{t("howItWorks.title")}</h2>
        <ol class="mt-3 flex max-w-md flex-col gap-1 sm:mt-4 sm:gap-1.5">
          {
            ["howItWorks.step1.title", "howItWorks.step2.title", "howItWorks.step3.title", "howItWorks.step4.title"].map((k, i) => (
              <li class="flex items-baseline gap-3 text-[0.9375rem] leading-snug text-white sm:text-base">
                <span class="w-4 shrink-0 font-display text-base font-semibold tabular-nums text-alivia-secondary">{i + 1}</span>
                {t(k as never)}
              </li>
            ))
          }
        </ol>
        <div class="mt-3 max-w-md rounded-2xl bg-alivia-primary-deep/70 px-3.5 py-2 sm:mt-4 sm:px-4 sm:py-3 ring-1 ring-white/20">
          <p class="text-[0.9375rem] font-semibold text-white sm:text-base">“{t("howItWorks.cmd.door.say")}”</p>
          <p class="mt-0.5 text-sm text-alivia-secondary">{t("howItWorks.cmd.door.reply")}</p>
        </div>
        <a href="#como-funciona" class={link}>{t("hero.ctaHowItWorks")}</a>
      </PaseoStop>

      <PaseoStop lang={lang} index={3} eyebrow={t("paseo.eyebrow.3")}>
        <h2 class={title}>{t("paseo.stop3.title")}</h2>
        <ul class="mt-4 flex max-w-md flex-col gap-2">
          <li class="flex items-center gap-3 text-[0.9375rem] font-semibold text-white sm:text-base">
            <span aria-hidden="true" class="size-2 shrink-0 rounded-full bg-alivia-secondary" />
            {t("howItWorks.cmd.door.target")} · {t("howItWorks.cmd.door.state")}
          </li>
          <li class="flex items-center gap-3 text-[0.9375rem] font-semibold text-white sm:text-base">
            <span aria-hidden="true" class="size-2 shrink-0 rounded-full bg-alivia-secondary" />
            {t("howItWorks.app.name")} · {t("howItWorks.app.now")}
          </li>
        </ul>
        <p class={body}>{t("howItWorks.step4.desc")}</p>
      </PaseoStop>

      <PaseoStop lang={lang} index={4} eyebrow={t("paseo.eyebrow.4")}>
        <h2 class={title}>{t("hero.card2.title")}</h2>
        <p class={body}>{t("hero.card2.desc")}</p>
        <p class="mt-3 max-w-md text-sm leading-snug text-alivia-hero-text">{t("howItWorks.note")}</p>
        <p class="mt-4 flex max-w-md items-start gap-3 text-[0.9375rem] font-semibold leading-snug text-white sm:text-base">
          <span aria-hidden="true" class="mt-[0.45em] size-1.5 shrink-0 rounded-full bg-alivia-secondary" />
          {t("twoLives.assisted.card3.title")}
        </p>
      </PaseoStop>

      <PaseoStop lang={lang} index={5} eyebrow={t("paseo.eyebrow.5")}>
        <h2 class={title}>{t("twoLives.title")}</h2>
        <div class="mt-4 grid w-full max-w-md grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-5">
          <div>
            <p class="text-xs font-semibold tracking-wider text-alivia-secondary uppercase">{t("twoLives.tabAssisted")}</p>
            <p class="mt-1 text-[0.9375rem] leading-snug text-white sm:text-base">{t("twoLives.assisted.card1.title")}</p>
          </div>
          <div>
            <p class="text-xs font-semibold tracking-wider text-alivia-secondary uppercase">{t("twoLives.tabCaregiver")}</p>
            <p class="mt-1 text-[0.9375rem] leading-snug text-white sm:text-base">{t("twoLives.caregiver.card1.title")}</p>
          </div>
        </div>
        <p class={body}>{t("hero.card3.desc")}</p>
        <a href="#beneficios" class={link}>{t("paseo.stop5.link")}</a>
      </PaseoStop>

      <PaseoStop lang={lang} index={6} eyebrow={t("paseo.eyebrow.6")}>
        <h2 class={title}>{t("hero.card4.title")}</h2>
        <p class={body}>{t("hero.card4.desc")}</p>
        <div class="mt-4 flex w-full flex-col gap-2 sm:mt-5 sm:w-auto sm:flex-row sm:gap-3">
          <a href="#dispositivos" data-magnetic class={btnPrimary}>{t("hero.card4.cta")}</a>
          <a href="#planes" data-magnetic class={btnSecondary}>{t("hero.ctaPlans")}</a>
        </div>
      </PaseoStop>
    </div>

  </div>
</section>

<script>
  import { initHeroAnimation } from '../scripts/heroAnimation';

  let cleanup: (() => void) | null = null;

  const start = () => {
    if (cleanup) cleanup();
    cleanup = initHeroAnimation();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }
  document.addEventListener('astro:page-load', start);
</script>

<style>
  #recorrido {
    overflow-x: clip;
  }

  /* The stage is 100lvh tall and the stops slide up over it, so the track is just the stops */
  #hero-viewport {
    height: 100vh;
    height: 100lvh;
  }

  #paseo-stops {
    margin-top: -100vh;
    margin-top: -100lvh;
  }

  /* Video stack: one element per clip; the script only moves opacity and currentTime */
  #hero-media {
    opacity: 0;
    transition: opacity 700ms var(--ease-out);
  }

  #hero-media[data-ready] {
    opacity: 1;
  }

  .hero-canvas-mask {
    -webkit-mask-image: linear-gradient(to bottom, #000 var(--mask-stop, 100%), transparent 100%);
    mask-image: linear-gradient(to bottom, #000 var(--mask-stop, 100%), transparent 100%);
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .hero-video:first-child {
    opacity: 1;
    visibility: visible;
  }

  /* Reading veils (#081745). Phones only get the bottom one; from md the text sits on one side. */
  .veil {
    position: absolute;
    inset: 0;
    z-index: 15;
    pointer-events: none;
  }

  .veil-top {
    bottom: auto;
    height: 7rem;
    background: linear-gradient(to bottom, rgb(8 23 69 / 0.45), transparent);
  }

  /* Light veils: the text carries its own shadow, so the video only needs a soft fall-off behind it */
  .veil-bottom {
    background: linear-gradient(
      to top,
      rgb(8 23 69 / 0.8) 0%,
      rgb(8 23 69 / 0.5) 22%,
      rgb(8 23 69 / 0.15) 36%,
      transparent 46%
    );
  }

  .veil-left,
  .veil-right {
    display: none;
    opacity: 0;
    transition: opacity 600ms var(--ease-out);
  }

  @media (min-width: 768px) {
    .veil-bottom {
      background: linear-gradient(to top, rgb(8 23 69 / 0.4) 0%, rgb(8 23 69 / 0.12) 18%, transparent 30%);
    }

    .veil-left,
    .veil-right {
      display: block;
    }

    .veil-left {
      background: linear-gradient(
        to right,
        rgb(8 23 69 / 0.78) 0%,
        rgb(8 23 69 / 0.55) 25%,
        rgb(8 23 69 / 0.28) 40%,
        transparent 55%
      );
    }

    .veil-right {
      background: linear-gradient(
        to left,
        rgb(8 23 69 / 0.78) 0%,
        rgb(8 23 69 / 0.55) 25%,
        rgb(8 23 69 / 0.28) 40%,
        transparent 55%
      );
    }

    #hero-viewport[data-text][data-side="left"] .veil-left,
    #hero-viewport[data-text][data-side="right"] .veil-right {
      opacity: 1;
    }
  }

  .rail-label {
    opacity: 0;
    transform: translateX(0.5rem);
    transition:
      opacity 400ms var(--ease-out),
      transform 400ms var(--ease-out);
  }

  .rail-dot {
    transition:
      background-color 400ms var(--ease-out),
      transform 400ms var(--ease-out);
  }

  .rail-link:hover .rail-label,
  .rail-link:focus-visible .rail-label,
  .rail-link[aria-current="true"] .rail-label {
    opacity: 1;
    transform: none;
  }

  .rail-link[aria-current="true"] .rail-dot {
    background-color: var(--color-alivia-secondary);
    transform: scale(1.5);
  }

  [data-rail-fill] {
    will-change: transform;
  }

  [data-paseo-hint] {
    transition: opacity 400ms var(--ease-out);
  }

  [data-paseo-hint].is-gone {
    opacity: 0;
  }

  .hint-line::after {
    content: "";
    position: absolute;
    inset: 0;
    background-color: #fff;
    animation: hint 2400ms var(--ease-in-out) infinite;
  }

  @keyframes hint {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hint-line::after {
      animation: none;
    }
  }

  /* Reduced motion / data saver: no stage, no rail; the stops stack as stills */
  :global(html[data-hero-still]) #hero-viewport {
    display: none;
  }

  :global(html[data-hero-still]) #paseo-stops {
    margin-top: 0;
    pointer-events: auto;
  }
</style>
