---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const commands = [
  {
    id: "light",
    say: t("howItWorks.cmd.light.say"),
    action: t("howItWorks.cmd.light.action"),
    target: t("howItWorks.cmd.light.target"),
    state: t("howItWorks.cmd.light.state"),
    reply: t("howItWorks.cmd.light.reply"),
  },
  {
    id: "door",
    say: t("howItWorks.cmd.door.say"),
    action: t("howItWorks.cmd.door.action"),
    target: t("howItWorks.cmd.door.target"),
    state: t("howItWorks.cmd.door.state"),
    reply: t("howItWorks.cmd.door.reply"),
  },
  {
    id: "window",
    say: t("howItWorks.cmd.window.say"),
    action: t("howItWorks.cmd.window.action"),
    target: t("howItWorks.cmd.window.target"),
    state: t("howItWorks.cmd.window.state"),
    reply: t("howItWorks.cmd.window.reply"),
  },
] as const;

const steps = [
  {
    title: t("howItWorks.step1.title"),
    desc: t("howItWorks.step1.desc"),
    kind: "voice",
  },
  {
    title: t("howItWorks.step2.title"),
    desc: t("howItWorks.step2.desc"),
    kind: "hub",
  },
  {
    title: t("howItWorks.step3.title"),
    desc: t("howItWorks.step3.desc"),
    kind: "device",
  },
  {
    title: t("howItWorks.step4.title"),
    desc: t("howItWorks.step4.desc"),
    kind: "confirm",
  },
] as const;
---

<section
  id="como-funciona"
  class="hiw scroll-mt-24 py-24 sm:py-28 bg-alivia-primary-deep text-white"
  data-cmd="light"
>
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div
      class="grid lg:grid-cols-12 gap-6 lg:gap-10 items-end mb-12 sm:mb-14"
      data-reveal-group
    >
      <h2
        class="lg:col-span-7 text-[2.25rem] leading-[1.02] sm:text-6xl lg:text-[4.25rem] font-semibold font-display text-white"
        data-reveal
      >
        {t("howItWorks.title")}
      </h2>
      <p
        class="lg:col-span-5 text-base sm:text-lg text-alivia-primary-mist leading-relaxed max-w-xl"
        data-reveal
      >
        {t("howItWorks.desc")}
      </p>
    </div>

    <div class="grid lg:grid-cols-12 gap-14 lg:gap-10">
      <!-- The spoken order is the focal point; the steps below follow what it sets off -->
      <div class="lg:col-span-5 lg:sticky lg:top-32 lg:self-start" data-reveal>
        <div role="group" aria-label={t("howItWorks.pickLabel")}>
          <p class="text-sm text-alivia-primary-light mb-3">
            {t("howItWorks.pickLabel")}
          </p>
          <div class="flex flex-wrap gap-2">
            {
              commands.map((cmd, i) => (
                <button
                  type="button"
                  class="hiw-chip press touch-target rounded-lg px-4 py-2.5 text-[0.9375rem] font-semibold focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-alivia-secondary-medium"
                  data-pick={cmd.id}
                  aria-pressed={i === 0 ? "true" : "false"}
                >
                  {cmd.say}
                </button>
              ))
            }
          </div>
        </div>

        <figure class="mt-10 sm:mt-12" aria-live="polite">
          <span class="hiw-wave flex items-end gap-[3px] h-6 mb-4" aria-hidden="true">
            {[0.45, 0.8, 1, 0.65, 0.9, 0.5, 0.7, 0.4, 0.85].map((h) => (
              <span style={`--h:${h}`} />
            ))}
          </span>
          {commands.map((cmd) => (
            <blockquote
              class="hiw-swap hiw-quote font-display font-semibold text-white text-[2.5rem] leading-[1.02] sm:text-[3.25rem] lg:text-[3.5rem]"
              data-for={cmd.id}
            >
              «{cmd.say}»
            </blockquote>
          ))}
        </figure>

        <p class="mt-10 max-w-sm border-t border-white/15 pt-4 text-sm text-alivia-primary-mist leading-relaxed">
          {t("howItWorks.note")}
        </p>
      </div>

    <ol
      class="hiw-flow relative lg:col-span-7 lg:col-start-6"
      aria-label={t("howItWorks.stepsLabel")}
    >
      <span class="hiw-track" aria-hidden="true"
        ><span class="hiw-fill"></span></span
      >

      {
        steps.map((step, i) => (
          <li
            class="hiw-stage relative grid grid-cols-[2.5rem_1fr] sm:grid-cols-[3.5rem_1fr] gap-x-2 py-7 sm:py-9 border-b border-white/10 last:border-b-0"
            style={`--i:${i}`}
            data-lit="true"
          >
            <span class="hiw-num font-display text-sm font-semibold tabular-nums" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>

            <div>
            <h3 class="text-xl sm:text-2xl font-semibold text-white mb-2">
              {step.title}
            </h3>
            <p class="text-[0.9375rem] sm:text-base text-alivia-primary-mist leading-relaxed max-w-md">
              {step.desc}
            </p>

            <div class="hiw-art mt-5 empty:hidden">
              {step.kind === "hub" && (
                <div class="inline-flex flex-wrap items-baseline gap-x-6 gap-y-2 text-sm">
                  <span class="flex items-center gap-1.5 text-alivia-secondary-light">
                    <span class="w-1.5 h-1.5 rounded-full bg-alivia-secondary" aria-hidden="true" />
                    {t("howItWorks.hub.where")} · {t("howItWorks.hub.offline")}
                  </span>
                  {commands.map((cmd) => (
                    <dl class="hiw-swap gap-x-5" style="--d:flex" data-for={cmd.id}>
                      <div class="flex gap-1.5">
                        <dt class="text-alivia-primary-light">{t("howItWorks.hub.action")}</dt>
                        <dd class="text-white font-medium">{cmd.action}</dd>
                      </div>
                      <div class="flex gap-1.5">
                        <dt class="text-alivia-primary-light">{t("howItWorks.hub.target")}</dt>
                        <dd class="text-white font-medium">{cmd.target}</dd>
                      </div>
                    </dl>
                  ))}
                </div>
              )}

              {step.kind === "device" && (
                <div class="flex items-center gap-3">
                  <span
                    class="hiw-device w-11 h-11 rounded-xl bg-alivia-primary flex items-center justify-center"
                    aria-hidden="true"
                  >
                    <svg
                      class="hiw-swap w-5 h-5"
                      data-for="light"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M9 18h6M10 21h4M12 3a6 6 0 00-3.6 10.8c.7.6 1.1 1.3 1.1 2.2h5c0-.9.4-1.6 1.1-2.2A6 6 0 0012 3z" />
                    </svg>
                    <svg
                      class="hiw-swap w-5 h-5"
                      data-for="door"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M4 21h16M6 21V3h12v18M6 3l7 2.5V21" />
                      <circle cx="11" cy="12.5" r=".8" fill="currentColor" />
                    </svg>
                    <svg
                      class="hiw-swap w-5 h-5"
                      data-for="window"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="4" y="3" width="16" height="18" rx="1.5" />
                      <path d="M12 3v18M4 12h8M14.5 8.5l3-2" />
                    </svg>
                  </span>
                  {commands.map((cmd) => (
                    <p class="hiw-swap text-sm" data-for={cmd.id}>
                      <span class="text-alivia-primary-light">{cmd.target}</span>
                      <span class="ml-1.5 font-semibold text-alivia-secondary-light">{cmd.state}</span>
                    </p>
                  ))}
                </div>
              )}

              {step.kind === "confirm" && (
                <div class="grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2 max-w-lg">
                  {commands.map((cmd) => (
                    <p class="hiw-swap text-white" data-for={cmd.id}>
                      <span class="block text-xs text-alivia-primary-light mb-1">Alivia</span>
                      «{cmd.reply}»
                    </p>
                  ))}
                  {commands.map((cmd) => (
                    <p class="hiw-swap text-white" data-for={cmd.id}>
                      <span class="flex gap-2 text-xs text-alivia-primary-light mb-1">
                        <span>{t("howItWorks.app.name")}</span>
                        <span aria-hidden="true">·</span>
                        <span>{t("howItWorks.app.now")}</span>
                      </span>
                      {cmd.target}: {cmd.state.toLowerCase()}
                    </p>
                  ))}
                </div>
              )}
            </div>
            </div>
          </li>
        ))
      }
    </ol>
    </div>
  </div>
</section>

<style>
  /* Command picker */
  .hiw-chip {
    background: var(--color-alivia-primary);
    color: var(--color-alivia-primary-mist);
  }
  .hiw-chip[aria-pressed="true"] {
    background: var(--color-alivia-secondary);
    color: var(--color-alivia-primary-deep);
  }
  @media (hover: hover) and (pointer: fine) {
    .hiw-chip[aria-pressed="false"]:hover {
      background: var(--color-alivia-primary-medium);
      color: #fff;
    }
  }

  /* Only the chosen command's content is shown; works without JS (default: light) */
  .hiw-swap {
    display: none;
  }
  .hiw[data-cmd="light"] [data-for="light"],
  .hiw[data-cmd="door"] [data-for="door"],
  .hiw[data-cmd="window"] [data-for="window"] {
    display: var(--d, block);
  }

  /* A thin rule down the left edge of the steps: the order travelling through the house */
  .hiw-flow {
    padding-left: 1.25rem;
  }
  .hiw-track {
    position: absolute;
    left: 0;
    top: 2.25rem;
    bottom: 2.25rem;
    width: 2px;
    background: rgb(255 255 255 / 0.12);
    overflow: hidden;
  }
  .hiw-fill {
    position: absolute;
    inset: 0;
    background: var(--color-alivia-secondary);
    transform-origin: top;
    transform: scaleY(var(--p, 1));
    /* One step per stage; matches STEP_MS in scripts/howItWorks.ts */
    transition: transform 320ms var(--ease-out);
  }
  @media (min-width: 640px) {
    .hiw-flow {
      padding-left: 1.75rem;
    }
  }

  /* Stage lighting as the command travels: the step number takes the accent once it is reached */
  .hiw-num {
    padding-top: 0.4rem;
    color: var(--color-alivia-primary-light);
    transition: color 200ms ease;
  }
  .hiw-stage[data-lit="true"] .hiw-num,
  .hiw-stage[data-lit="pulse"] .hiw-num {
    color: var(--color-alivia-secondary);
  }
  .hiw-art {
    transition:
      opacity 220ms var(--ease-out),
      transform 260ms var(--ease-out);
  }
  /* Replay resets snap back; only the forward path animates */
  .hiw.is-resetting :is(.hiw-fill, .hiw-art, .hiw-num, .hiw-device) {
    transition: none;
  }
  .hiw-stage[data-lit="false"] .hiw-art {
    opacity: 0.3;
    transform: translateY(6px);
  }

  /* The spoken order changes in place when another chip is picked */
  @media (prefers-reduced-motion: no-preference) {
    .hiw-quote {
      animation: hiw-quote-in 320ms var(--ease-out);
    }
  }
  @keyframes hiw-quote-in {
    from {
      opacity: 0;
      transform: translateY(0.25em);
    }
  }
  .hiw-device {
    color: var(--color-alivia-primary-light);
    transition: color 200ms ease;
  }
  .hiw-stage[data-lit="true"] .hiw-device,
  .hiw-stage[data-lit="pulse"] .hiw-device {
    color: var(--color-alivia-secondary-light);
  }

  /* Voice waveform: still bars by default, moves only while "speaking" */
  .hiw-wave span {
    width: 5px;
    height: 100%;
    border-radius: 2px;
    background: var(--color-alivia-secondary);
    transform-origin: bottom;
    transform: scaleY(calc(var(--h) * 0.6));
  }
  @media (prefers-reduced-motion: no-preference) {
    .hiw.is-speaking .hiw-wave span {
      animation: hiw-wave 420ms var(--ease-in-out) infinite alternate;
    }
    .hiw.is-speaking .hiw-wave span:nth-child(2n) {
      animation-delay: -210ms;
    }
    .hiw.is-speaking .hiw-wave span:nth-child(3n) {
      animation-delay: -120ms;
    }
  }
  @keyframes hiw-wave {
    from {
      transform: scaleY(0.25);
    }
    to {
      transform: scaleY(var(--h));
    }
  }
</style>

<script>
  import { initHowItWorks } from "../scripts/howItWorks";

  let cleanup: (() => void) | null = null;

  const start = () => {
    if (cleanup) cleanup();
    cleanup = initHowItWorks();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start);
  } else {
    start();
  }
  document.addEventListener("astro:page-load", start);
</script>
