---
import type { Lang } from '../i18n/ui';
import DeviceExplode from './DeviceExplode.astro';
import IncludedDevices from './IncludedDevices.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="dispositivos" class="scroll-mt-24 relative w-full bg-white text-alivia-neutral-dark">
  <IncludedDevices lang={lang} />
  <DeviceExplode lang={lang} />
</section>
