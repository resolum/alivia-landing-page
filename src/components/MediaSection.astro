---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { getProductVideo } from '../data/videos';
import VideoPlayer from './ui/VideoPlayer.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const productVideo = getProductVideo(lang);
---

<section
  id="audiovisual"
  class="py-20 bg-alivia-tertiary text-alivia-neutral-dark border-t border-alivia-tertiary-medium"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span
        class="text-xs uppercase tracking-widest font-semibold text-alivia-primary bg-alivia-tertiary-medium px-3.5 py-1 rounded-full border border-alivia-tertiary-dark"
      >
        {t("media.badge")}
      </span>
      <h2
        class="text-3xl sm:text-4xl font-semibold font-display mt-4 mb-4 text-alivia-primary"
      >
        {t("media.title")}
      </h2>
      <p class="text-base sm:text-lg text-alivia-neutral-gray">
        {t("media.desc")}
      </p>
    </div>

    <div
      class="max-w-4xl mx-auto overflow-hidden rounded-3xl bg-alivia-primary-deep text-white shadow-2xl border border-alivia-primary-medium"
    >
      <VideoPlayer
        id="product-video"
        provider={productVideo.provider}
        source={productVideo.source}
        title={productVideo.title}
        description={productVideo.description}
        poster={productVideo.poster}
        captions={productVideo.captions}
        duration={productVideo.duration}
        fallbackTargetId="transcription-content"
        fallbackMessage={t("media.videoUnavailable")}
        fallbackLinkLabel={t("media.videoFallbackLink")}
        externalUrl={productVideo.externalUrl}
        externalLabel={t("media.videoExternalLink")}
        playLabel={t("media.videoTitle")}
        clickLabel={t("media.videoClick")}
      />
    </div>
  </div>
</section>

<script>
  const setupTranscriptToggle = () => {
    const transcriptBtn = document.getElementById("toggle-transcript-btn");
    const transcriptContent = document.getElementById("transcription-content");

    if (!transcriptBtn || !transcriptContent) return;
    if (transcriptBtn.dataset.initialized === "true") return;
    transcriptBtn.dataset.initialized = "true";

    const showText =
      transcriptBtn.getAttribute("data-show-text") || "Ver transcripción";
    const hideText =
      transcriptBtn.getAttribute("data-hide-text") || "Ocultar transcripción";

    transcriptBtn.addEventListener("click", () => {
      const isHidden = transcriptContent.classList.contains("hidden");

      if (isHidden) {
        transcriptContent.classList.remove("hidden");
        transcriptBtn.setAttribute("aria-expanded", "true");
        transcriptBtn.textContent = hideText;
      } else {
        transcriptContent.classList.add("hidden");
        transcriptBtn.setAttribute("aria-expanded", "false");
        transcriptBtn.textContent = showText;
      }
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupTranscriptToggle);
  } else {
    setupTranscriptToggle();
  }
  document.addEventListener("astro:page-load", setupTranscriptToggle);
</script>
