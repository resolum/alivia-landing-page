---
import type { Block } from "../../data/legal/types";
import type { Lang } from "../../i18n/ui";
import Callout from "../ui/Callout.astro";
import ContactCard from "./ContactCard.astro";

interface Props {
  blocks: Block[];
  lang: Lang;
}

const { blocks, lang } = Astro.props;
---

<div class="space-y-5">
  {
    blocks.map((block) => {
      if (block.type === "paragraph") {
        return <p class="max-w-[62ch] leading-[1.7] text-alivia-neutral-dark" set:html={block.html} />;
      }

      if (block.type === "list") {
        return (
          <ul class="max-w-[62ch] list-disc pl-5 space-y-2.5 text-alivia-neutral-dark marker:text-alivia-secondary-dark">
            {block.items.map((item) => (
              <li class="pl-1 leading-[1.7]" set:html={item} />
            ))}
          </ul>
        );
      }

      if (block.type === "cards") {
        return (
          <dl class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3 !my-8">
            {block.items.map((item) => (
              <div class="p-5 rounded-2xl bg-alivia-surface-mist">
                <dt class="font-semibold text-alivia-primary leading-snug">{item.title}</dt>
                <dd class="mt-2 text-[0.9375rem] text-alivia-neutral-gray leading-relaxed">{item.text}</dd>
              </div>
            ))}
          </dl>
        );
      }

      if (block.type === "callout") {
        return <Callout variant={block.variant} title={block.title} text={block.text} />;
      }

      if (block.type === "contact") {
        return <ContactCard lang={lang} />;
      }

      return null;
    })
  }
</div>
