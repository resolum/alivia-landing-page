---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="audiovisual"
  class="py-20 bg-alivia-tertiary text-alivia-neutral-dark border-t border-alivia-tertiary-medium"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span
        class="text-xs uppercase tracking-widest font-semibold text-alivia-primary bg-alivia-tertiary-medium px-3.5 py-1 rounded-full border border-alivia-tertiary-dark"
      >
        {t("media.badge")}
      </span>
      <h2
        class="text-3xl sm:text-4xl font-semibold font-display mt-4 mb-4 text-alivia-primary"
      >
        {t("media.title")}
      </h2>
      <p class="text-base sm:text-lg text-alivia-neutral-gray">
        {t("media.desc")}
      </p>
    </div>
    <div
      class="max-w-4xl mx-auto rounded-3xl bg-alivia-primary-deep text-white overflow-hidden shadow-2xl border border-alivia-primary-medium"
    >
      <div
        class="relative aspect-video bg-alivia-primary flex items-center justify-center group overflow-hidden"
      >
        <div
          class="absolute inset-0 bg-gradient-to-tr from-alivia-primary-deep via-alivia-primary to-alivia-primary-medium opacity-90"
        >
        </div>
        <div
          class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center z-10"
        >
          <div
            class="w-20 h-20 rounded-full bg-alivia-secondary text-alivia-primary flex items-center justify-center shadow-xl group-hover:scale-110 transition-transform cursor-pointer focus-visible:ring-4 focus-visible:ring-alivia-secondary-medium mb-4 touch-target"
          >
            <svg
              class="w-10 h-10 translate-x-0.5"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M8 5v14l11-7z"></path>
            </svg>
          </div>
          <p class="text-lg font-semibold text-white font-display">
            {t("media.videoTitle")}
          </p>
          <span class="text-xs text-alivia-primary-light mt-1"
            >{t("media.videoDuration")}</span
          >
        </div>
        <div class="absolute top-4 left-4 z-20 flex items-center gap-2">
          <span
            class="px-3 py-1 rounded-full bg-black/60 backdrop-blur-md text-xs font-semibold text-alivia-secondary-medium border border-white/10"
          >
            HD 1080p
          </span>
          <span
            class="px-3 py-1 rounded-full bg-black/60 backdrop-blur-md text-xs font-medium text-white border border-white/10"
          >
            02:45
          </span>
        </div>
      </div>
      <div
        class="p-6 bg-alivia-primary-deep border-t border-alivia-primary-medium flex flex-wrap items-center justify-between gap-4"
      >
        <div
          class="flex flex-wrap items-center gap-2"
          aria-label={t("media.controlsLabel")}
        >
          <button
            type="button"
            class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-alivia-primary-medium text-alivia-secondary-mint hover:bg-alivia-primary transition-colors flex items-center gap-1.5 focus-visible:ring-2 focus-visible:ring-alivia-secondary-medium touch-target"
            aria-label={t("media.subtitlesAriaLabel")}
          >
            <svg
              class="w-4 h-4 text-alivia-secondary"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"
              ></path>
            </svg>
            {t("media.subtitles")}
          </button>

          <button
            type="button"
            class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-alivia-primary-medium text-alivia-secondary-mint hover:bg-alivia-primary transition-colors flex items-center gap-1.5 focus-visible:ring-2 focus-visible:ring-alivia-secondary-medium touch-target"
            aria-label={t("media.signLanguageAriaLabel")}
          >
            <svg
              class="w-4 h-4 text-alivia-secondary"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
            {t("media.signLanguage")}
          </button>

          <button
            type="button"
            class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-alivia-primary-medium text-alivia-secondary-mint hover:bg-alivia-primary transition-colors flex items-center gap-1.5 focus-visible:ring-2 focus-visible:ring-alivia-secondary-medium touch-target"
            aria-label={t("media.audiodescAriaLabel")}
          >
            <svg
              class="w-4 h-4 text-alivia-secondary"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
              ></path>
            </svg>
            {t("media.audiodesc")}
          </button>
        </div>
        <button
          id="toggle-transcript-btn"
          type="button"
          class="px-4 py-2 rounded-lg text-xs font-semibold bg-alivia-secondary text-alivia-primary hover:bg-alivia-secondary-dark hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary-medium touch-target"
          aria-expanded="false"
          aria-controls="transcription-content"
          data-show-text={t("media.showTranscript")}
          data-hide-text={t("media.hideTranscript")}
        >
          {t("media.showTranscript")}
        </button>
      </div>
      <div
        id="transcription-content"
        class="hidden p-8 bg-alivia-primary/80 border-t border-alivia-primary-medium text-sm text-alivia-primary-mist leading-relaxed space-y-4"
        aria-label={t("media.transcriptLabel")}
      >
        <div
          class="flex items-center justify-between pb-3 border-b border-alivia-primary-medium"
        >
          <h3 class="text-base font-semibold text-white font-display">
            {t("media.transcriptTitle")}
          </h3>
          <span class="text-xs text-alivia-secondary-medium">{t("media.transcriptAltLabel")}</span
          >
        </div>

        <p>{t("media.transcript.p1")}</p>
        <p>{t("media.transcript.p2")}</p>
        <p>{t("media.transcript.p3")}</p>
        <p>{t("media.transcript.p4")}</p>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const transcriptBtn = document.getElementById("toggle-transcript-btn");
    const transcriptContent = document.getElementById("transcription-content");

    if (transcriptBtn && transcriptContent) {
      const showText = transcriptBtn.getAttribute("data-show-text") || "Ver Transcripción Completa";
      const hideText = transcriptBtn.getAttribute("data-hide-text") || "Ocultar Transcripción";

      transcriptBtn.addEventListener("click", () => {
        const isHidden = transcriptContent.classList.contains("hidden");
        if (isHidden) {
          transcriptContent.classList.remove("hidden");
          transcriptBtn.setAttribute("aria-expanded", "true");
          transcriptBtn.textContent = hideText;
        } else {
          transcriptContent.classList.add("hidden");
          transcriptBtn.setAttribute("aria-expanded", "false");
          transcriptBtn.textContent = showText;
        }
      });
    }
  });
</script>
