---
import type { Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";
import { companyInfo } from "../../data/company";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="!my-8 p-6 sm:p-8 rounded-2xl bg-alivia-primary text-white">
  <p class="text-lg font-semibold font-display">{t("legal.officialChannel")}</p>
  <dl class="mt-5 grid gap-5 sm:grid-cols-2">
    <div class="min-w-0">
      <dt class="text-sm text-alivia-primary-light">
        {lang === "es" ? "Correo electrónico oficial" : "Official email"}
      </dt>
      <dd class="mt-1">
        <a
          href={`mailto:${companyInfo.privacyEmail}`}
          class="text-lg font-semibold text-alivia-secondary-medium break-all underline underline-offset-4 decoration-alivia-secondary/50 hover:text-white rounded focus-visible:ring-2 focus-visible:ring-alivia-secondary"
        >
          {companyInfo.privacyEmail}
        </a>
      </dd>
    </div>
    <div class="min-w-0">
      <dt class="text-sm text-alivia-primary-light">{lang === "es" ? "Razón social" : "Legal entity"}</dt>
      <dd class="mt-1 text-lg font-medium">{companyInfo.legalName}</dd>
    </div>
  </dl>
</div>
