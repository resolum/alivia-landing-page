---
import type { Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";
import type { LegalDoc } from "../../data/legal/types";
import { companyInfo } from "../../data/company";

interface Props {
  doc: LegalDoc;
  lang: Lang;
}

const { doc, lang } = Astro.props;
const t = useTranslations(lang);
---

<aside class="print:hidden mb-10 lg:mb-0">
  <details class="toc-mobile lg:hidden rounded-2xl bg-alivia-surface-mist group">
    <summary class="flex items-center justify-between gap-3 min-h-13 px-5 cursor-pointer font-semibold text-alivia-primary list-none [&::-webkit-details-marker]:hidden rounded-2xl">
      {t("legal.tableOfContents")}
      <svg class="w-5 h-5 text-alivia-neutral-blue shrink-0 transition-transform duration-200 ease-[var(--ease-out)] group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </summary>
    <nav class="px-3 pb-3" aria-label={t("legal.tableOfContents")}>
      {
        doc.sections.map((sec) => (
          <a
            href={`#${sec.id}`}
            class="toc-link flex gap-2 min-h-11 items-center px-2 rounded-lg text-[0.9375rem] text-alivia-neutral-dark active:bg-white"
          >
            <span class="text-alivia-secondary-dark font-semibold tabular-nums w-5 shrink-0">{sec.number}.</span>
            {sec.title}
          </a>
        ))
      }
    </nav>
  </details>

  <div class="hidden lg:block sticky top-28">
    <p class="text-sm font-semibold text-alivia-neutral-blue mb-3">{t("legal.tableOfContents")}</p>
    <nav aria-label={t("legal.tableOfContents")}>
      <ol class="space-y-0.5">
        {
          doc.sections.map((sec) => (
            <li>
              <a
                href={`#${sec.id}`}
                class="toc-link flex gap-2.5 py-2 px-3 -mx-3 rounded-lg text-[0.9375rem] leading-snug text-alivia-neutral-gray hover:text-alivia-primary hover:bg-alivia-surface-mist aria-[current=true]:text-alivia-primary aria-[current=true]:bg-alivia-surface transition-colors duration-150"
              >
                <span class="text-alivia-secondary-dark font-semibold tabular-nums w-5 shrink-0">{sec.number}.</span>
                <span>{sec.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="mt-10 text-[0.9375rem] leading-relaxed">
      <p class="font-semibold text-alivia-primary">{t("legal.supportBoxTitle")}</p>
      <p class="mt-1 text-alivia-neutral-gray">{t("legal.supportBoxDesc")}</p>
      <a
        href={`mailto:${companyInfo.privacyEmail}`}
        class="mt-2 inline-block break-all font-semibold text-alivia-primary-medium underline underline-offset-4 decoration-alivia-primary-light hover:text-alivia-primary"
      >
        {companyInfo.privacyEmail}
      </a>
    </div>
  </div>
</aside>
