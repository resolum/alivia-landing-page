---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = [
  {
    title: t("howItWorks.step1.title"),
    desc: t("howItWorks.step1.desc"),
    icon: "voice",
  },
  {
    title: t("howItWorks.step2.title"),
    desc: t("howItWorks.step2.desc"),
    icon: "hub",
  },
  {
    title: t("howItWorks.step3.title"),
    desc: t("howItWorks.step3.desc"),
    icon: "device",
  },
  {
    title: t("howItWorks.step4.title"),
    desc: t("howItWorks.step4.desc"),
    icon: "confirm",
  },
] as const;
---

<section id="como-funciona" class="scroll-mt-24 py-20 bg-alivia-primary-deep text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span
        class="text-xs uppercase tracking-widest font-semibold text-alivia-secondary-mint px-3.5 py-1 rounded-full border border-alivia-secondary-medium/40 bg-alivia-primary/70"
      >
        {t("howItWorks.badge")}
      </span>
      <h2
        class="text-3xl sm:text-4xl font-bold font-display mt-4 mb-4 text-white"
      >
        {t("howItWorks.title")}
      </h2>
      <p class="text-base sm:text-lg text-alivia-primary-mist leading-relaxed">
        {t("howItWorks.desc")}
      </p>
    </div>

    <ol
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6"
      aria-label={t("howItWorks.stepsLabel")}
    >
      {
        steps.map((step, index) => (
          <li class="relative rounded-2xl bg-alivia-primary/60 border border-alivia-primary-medium/70 p-6 pt-8 h-full">
            <span
              class="absolute -top-4 left-6 inline-flex items-center justify-center w-9 h-9 rounded-full bg-alivia-secondary text-alivia-primary-deep text-sm font-bold shadow-lg shadow-alivia-secondary/20"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <div class="w-11 h-11 rounded-xl bg-alivia-primary-deep text-alivia-secondary flex items-center justify-center mb-4">
              {step.icon === "voice" && (
                <svg
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 18.5a6.5 6.5 0 006.5-6.5M5.5 12A6.5 6.5 0 0112 5.5m0 13v3m-4 0h8M12 15a3 3 0 003-3V6a3 3 0 10-6 0v6a3 3 0 003 3z"
                  />
                </svg>
              )}
              {step.icon === "hub" && (
                <svg
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <rect x="6" y="6" width="12" height="12" rx="2" />
                  <rect x="9.5" y="9.5" width="5" height="5" rx="1" />
                  <path
                    stroke-linecap="round"
                    d="M9 3v3m6-3v3M9 18v3m6-3v3M3 9h3m-3 6h3m12-6h3m-3 6h3"
                  />
                </svg>
              )}
              {step.icon === "device" && (
                <svg
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M13 2L4.5 13.5H11l-1 8.5 8.5-11.5H12l1-8.5z"
                  />
                </svg>
              )}
              {step.icon === "confirm" && (
                <svg
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
              )}
            </div>
            <h3 class="text-base font-bold text-white mb-2">{step.title}</h3>
            <p class="text-sm text-alivia-primary-mist leading-relaxed">
              {step.desc}
            </p>
          </li>
        ))
      }
    </ol>

    <p
      class="mt-10 mx-auto w-fit flex items-center gap-2 rounded-full border border-alivia-secondary-medium/40 bg-alivia-primary/60 px-5 py-2.5 text-xs sm:text-sm font-semibold text-alivia-secondary-mint text-center"
    >
      <svg
        class="w-4 h-4 shrink-0 text-alivia-secondary"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
        />
      </svg>
      {t("howItWorks.note")}
    </p>
  </div>
</section>
