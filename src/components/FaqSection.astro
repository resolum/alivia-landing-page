---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { getFaqItems } from '../data/faq';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const faqItems = getFaqItems(lang);
---

<section id="faq" class="scroll-mt-24 py-20 sm:py-28 bg-alivia-surface-mist text-alivia-primary">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 mb-14 sm:mb-20">
    <div class="lg:col-span-4 lg:sticky lg:top-32 lg:self-start" data-reveal>
      <h2
        class="text-[2rem] leading-[1.1] sm:text-5xl font-semibold font-display mb-5 text-alivia-primary"
      >
        {t("faq.title")}
      </h2>
      <p class="text-base sm:text-lg text-alivia-neutral-blue leading-relaxed">
        {t("faq.desc")}
      </p>
    </div>
    <div class="lg:col-span-8 space-y-3" aria-label={t("faq.listLabel")} data-reveal-group>
      {faqItems.map((item, i) => (
        <div class="faq-item bg-white rounded-2xl overflow-hidden" data-reveal={i % 2 ? "right" : "left"}>
          <button
            class="faq-trigger w-full flex items-center justify-between gap-4 px-5 sm:px-6 py-5 text-left font-semibold text-base sm:text-lg text-alivia-primary hover:bg-alivia-surface/60 transition-colors focus-visible:ring-4 focus-visible:ring-alivia-primary-medium touch-target"
            aria-expanded="false"
          >
            <span>{item.question}</span>
            <svg
              class="faq-chevron w-5 h-5 text-alivia-neutral-blue shrink-0 transition-transform duration-250 ease-[var(--ease-out)]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="faq-body overflow-hidden" style="height:0">
            <div class="px-5 sm:px-6 pb-6 pt-1 text-base text-alivia-neutral-blue leading-relaxed max-w-[68ch]">
              {item.answer}
            </div>
          </div>
        </div>
      ))}
    </div>
    </div>
    <div class="rounded-3xl bg-alivia-primary px-6 py-10 sm:p-14 text-center" data-reveal="scale">
      <blockquote
        data-words
        class="text-xl sm:text-3xl font-semibold font-display text-white leading-snug max-w-3xl mx-auto"
      >
        {t("faq.quote").split(" ").map((word, i) => <>{i > 0 && " "}<span data-word>{word}</span></>)}
      </blockquote>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const DURATION = matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 260;
    const EASING   = getComputedStyle(document.documentElement).getPropertyValue("--ease-out").trim() || "ease-out";

    document.querySelectorAll<HTMLElement>(".faq-item").forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>(".faq-trigger")!;
      const body    = item.querySelector<HTMLElement>(".faq-body")!;
      const chevron = item.querySelector<SVGElement>(".faq-chevron")!;
      let isOpen = false;
      let currentAnim: Animation | null = null;

      trigger.addEventListener("click", () => {
        if (currentAnim) currentAnim.cancel();

        if (!isOpen) {
          body.style.height = "auto";
          const targetH = body.scrollHeight;
          body.style.height = "0px";
          currentAnim = body.animate(
            [{ height: "0px" }, { height: targetH + "px" }],
            { duration: DURATION, easing: EASING, fill: "forwards" },
          );
          currentAnim.onfinish = () => { body.style.height = "auto"; currentAnim = null; };
          chevron.style.transform = "rotate(180deg)";
          trigger.setAttribute("aria-expanded", "true");
          isOpen = true;
        } else {
          const currentH = body.scrollHeight;
          body.style.height = currentH + "px";
          currentAnim = body.animate(
            [{ height: currentH + "px" }, { height: "0px" }],
            { duration: DURATION, easing: EASING, fill: "forwards" },
          );
          currentAnim.onfinish = () => { body.style.height = "0"; currentAnim = null; };
          chevron.style.transform = "rotate(0deg)";
          trigger.setAttribute("aria-expanded", "false");
          isOpen = false;
        }
      });
    });
  });
</script>
