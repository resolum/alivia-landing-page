---
import LegalDocument from "./LegalDocument.astro";
import { getLegalDoc } from "../../data/legal";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const doc = getLegalDoc("terms", lang);

const summary = lang === "es" ? [
  { title: "Garantía de 30 Días", text: "Derecho a devolución si el sistema no se adecúa a las necesidades asistenciales." },
  { title: "Marco Legal Peruano", text: "Regido bajo la legislación de la República del Perú y fuero de Lima." },
  { title: "Soporte Cercano", text: "Asistencia técnica capacitada y canal oficial para atención al usuario." },
] : [
  { title: "30-Day Guarantee", text: "Right to refund if system does not suit assistive needs." },
  { title: "Peruvian Legal Framework", text: "Governed under Peruvian laws and Judicial District of Lima." },
  { title: "Dedicated Support", text: "Trained technical assistance and official support channel." },
];
---

<LegalDocument doc={doc} lang={lang} activeTab="terms" summary={summary} />
