---
---

<footer class="bg-alivia-primary-deep text-white border-t border-alivia-primary-medium pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-alivia-primary-medium/60"
    >
      <div class="space-y-4">
        <div class="flex items-center gap-2.5">
          <span
            class="text-2xl font-semibold tracking-tight text-white font-display"
          >
            Alivia
          </span>
        </div>
        <p class="text-xs text-alivia-primary-mist leading-relaxed">
          Sistema de domótica asistida por voz con procesamiento local Edge para
          personas con discapacidad motora severa y supervisión remota para
          cuidadores.
        </p>
        <div class="pt-2">
          <span
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-alivia-primary text-alivia-secondary-mint border border-alivia-secondary-medium/40"
          >
            <svg
              class="w-4 h-4 text-alivia-secondary"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Sello WCAG 2.1 AA Cumplido
          </span>
        </div>
      </div>
      <div>
        <h3
          class="text-sm font-semibold uppercase tracking-wider text-white mb-4 font-display"
        >
          Plataforma
        </h3>
        <ul class="space-y-2.5 text-xs text-alivia-primary-mist">
          <li>
            <a
              href="#que-es"
              class="hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary rounded px-1 py-0.5"
              >¿Qué es Alivia?</a
            >
          </li>
          <li>
            <a
              href="#como-funciona"
              class="hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary rounded px-1 py-0.5"
              >Cómo funciona (Dos Vidas)</a
            >
          </li>
          <li>
            <a
              href="#dispositivos"
              class="hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary rounded px-1 py-0.5"
              >Hub Core y Dispositivos</a
            >
          </li>
          <li>
            <a
              href="#audiovisual"
              class="hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary rounded px-1 py-0.5"
              >Demostración Audiovisual</a
            >
          </li>
          <li>
            <a
              href="#planes"
              class="hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary rounded px-1 py-0.5"
              >Planes y Equipamiento</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h3
          class="text-sm font-semibold uppercase tracking-wider text-white mb-4 font-display"
        >
          Compañía y Equipo
        </h3>
        <ul class="space-y-2.5 text-xs text-alivia-primary-mist">
          <li>
            <a
              href="#equipo"
              class="hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary rounded px-1 py-0.5"
              >Detrás de Alivia (Equipo)</a
            >
          </li>
          <li>
            <a
              href="#testimonios"
              class="hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary rounded px-1 py-0.5"
              >Testimonios Reales</a
            >
          </li>
          <li>
            <a
              href="#faq"
              class="hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary rounded px-1 py-0.5"
              >Preguntas Frecuentes</a
            >
          </li>
          <li>
            <a
              href="https://app.alivia.care/login"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary rounded px-1 py-0.5"
              >Acceso Aplicación Cuidadores</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h3
          class="text-sm font-semibold uppercase tracking-wider text-white mb-4 font-display"
        >
          Urgencias y Contacto
        </h3>
        <div class="space-y-3 text-xs text-alivia-primary-mist">
          <p>
            <strong class="block text-white"
              >Soporte Técnico Asistencial 24/7</strong
            >
            Atención prioritaria para usuarios y familias registradas.
          </p>
        </div>
      </div>
    </div>
    <div
      class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-alivia-primary-light"
    >
      <p>
        © 2026 Alivia Tecnología Asistencial. Todos los derechos reservados.
      </p>

      <div class="flex items-center gap-6">
        <a
          href="#privacidad"
          class="hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary"
          >Política de Privacidad</a
        >
        <a
          href="#cookies"
          class="hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary"
          >Términos y Condiciones de Uso</a
        >
      </div>
    </div>
  </div>
</footer>
