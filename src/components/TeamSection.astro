---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { getTeamMembers } from '../data/team';
import { getTeamVideo } from '../data/videos';
import TeamCard from './ui/TeamCard.astro';
import VideoPlayer from './ui/VideoPlayer.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const teamMembers = getTeamMembers(lang);
const teamVideo = getTeamVideo(lang);
---

<section
  id="equipo"
  class="py-20 bg-alivia-tertiary text-alivia-neutral-dark border-t border-alivia-tertiary-medium"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span
        class="text-xs uppercase tracking-widest font-semibold text-alivia-primary bg-alivia-tertiary-medium px-3.5 py-1 rounded-full border border-alivia-tertiary-dark"
      >
        {t("team.badge")}
      </span>
      <h2
        class="text-3xl sm:text-4xl font-semibold font-display mt-4 mb-4 text-alivia-primary"
      >
        {t("team.title")}
      </h2>
      <p class="text-base sm:text-lg text-alivia-neutral-gray">
        {t("team.desc")}
      </p>
    </div>

    <div
      id="team-members"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
    >
      {teamMembers.map((member) => <TeamCard member={member} lang={lang} />)}
    </div>

    <div class="mt-20 max-w-4xl mx-auto">
      <div class="text-center mb-8">
        <span
          class="text-xs uppercase tracking-widest font-semibold text-alivia-primary bg-alivia-tertiary-medium px-3.5 py-1 rounded-full border border-alivia-tertiary-dark"
        >
          {t("team.aboutBadge")}
        </span>
        <h3
          class="text-2xl sm:text-3xl font-semibold font-display mt-4 mb-3 text-alivia-primary"
        >
          {t("team.videoTitle")}
        </h3>
        <p class="text-base text-alivia-neutral-gray">
          {t("team.videoDescription")}
        </p>
      </div>

      <div
        class="overflow-hidden rounded-3xl bg-alivia-primary-deep text-white shadow-2xl border border-alivia-primary-medium"
      >
        <VideoPlayer
          id="team-video"
          provider={teamVideo.provider}
          source={teamVideo.source}
          title={t("team.videoIframeTitle")}
          description={teamVideo.description}
          duration={teamVideo.duration}
          fallbackTargetId="team-video-fallback"
          fallbackMessage={t("team.videoUnavailable")}
          fallbackLinkLabel={t("team.videoShowFallback")}
          externalUrl={teamVideo.externalUrl}
          playLabel={t("team.videoPlay")}
          clickLabel={t("team.videoClick")}
        />
      </div>

      <div
        id="team-video-fallback"
        hidden
        class="mt-6 rounded-2xl border border-alivia-tertiary-dark bg-white p-6 sm:p-8"
        aria-label={t("team.videoFallbackTitle")}
      >
        <h3 class="text-lg font-semibold text-alivia-primary font-display">
          {t("team.videoFallbackTitle")}
        </h3>
        <p class="mt-2 text-sm text-alivia-neutral-gray">
          {t("team.videoFallbackDesc")}
        </p>
        <ul
          class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2"
          aria-label={t("team.videoMembersLabel")}
        >
          {
            teamMembers.map((member) => (
              <li class="rounded-xl bg-alivia-tertiary/60 p-4">
                <p class="font-semibold text-alivia-primary">{member.name}</p>
                <p class="mt-1 text-sm text-alivia-neutral-gray">{member.role}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  const setupTeamFallbackToggle = () => {
    const toggle = document.getElementById("toggle-team-fallback");
    const panel = document.getElementById("team-video-fallback");

    if (!toggle || !panel) return;
    if (toggle.dataset.initialized === "true") return;
    toggle.dataset.initialized = "true";

    const showText =
      toggle.getAttribute("data-show-text") || "Ver resumen del equipo";
    const hideText =
      toggle.getAttribute("data-hide-text") || "Ocultar resumen del equipo";

    toggle.addEventListener("click", () => {
      const isHidden = panel.hasAttribute("hidden");

      if (isHidden) {
        panel.removeAttribute("hidden");
        toggle.setAttribute("aria-expanded", "true");
        toggle.textContent = hideText;
      } else {
        panel.setAttribute("hidden", "");
        toggle.setAttribute("aria-expanded", "false");
        toggle.textContent = showText;
      }
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupTeamFallbackToggle);
  } else {
    setupTeamFallbackToggle();
  }
  document.addEventListener("astro:page-load", setupTeamFallbackToggle);
</script>
