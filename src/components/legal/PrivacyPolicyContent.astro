---
import LegalDocument from "./LegalDocument.astro";
import { getLegalDoc } from "../../data/legal";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const doc = getLegalDoc("privacy", lang);
---

<LegalDocument doc={doc} lang={lang} activeTab="privacy" />
