---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import { companyInfo } from "../data/company";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const privacyHref =
  lang === "es" ? "/es/politica-de-privacidad" : "/privacy-policy";
const termsHref =
  lang === "es" ? "/es/terminos-y-condiciones" : "/terms-and-conditions";
---

<footer
  class="bg-alivia-primary-deep text-white border-t border-alivia-primary-medium pt-16 pb-12"
>
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-alivia-primary-medium/60"
    >
      <div class="space-y-4">
        <div class="flex items-center gap-2.5">
          <span
            class="text-2xl font-semibold tracking-tight text-white font-display"
          >
            Alivia
          </span>
        </div>
        <p class="text-[0.9375rem] text-alivia-primary-mist leading-relaxed max-w-xs">
          {t("footer.tagline")}
        </p>
      </div>
      <div>
        <h3
          class="text-base font-semibold text-white mb-3 font-display"
        >
          {t("footer.colPlatform")}
        </h3>
        <ul class="space-y-0.5 text-[0.9375rem] text-alivia-primary-mist">
          <li>
            <a
              href="#que-es"
              class="inline-flex items-center min-h-10 hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary rounded"
              >{t("footer.link.whatIsAlivia")}</a
            >
          </li>
          <li>
            <a
              href="#como-funciona"
              class="inline-flex items-center min-h-10 hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary rounded"
              >{t("footer.link.howItWorks")}</a
            >
          </li>
          <li>
            <a
              href="#beneficios"
              class="inline-flex items-center min-h-10 hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary rounded"
              >{t("footer.link.benefits")}</a
            >
          </li>
          <li>
            <a
              href="#dispositivos"
              class="inline-flex items-center min-h-10 hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary rounded"
              >{t("footer.link.hubDevices")}</a
            >
          </li>
          <li>
            <a
              href="#audiovisual"
              class="inline-flex items-center min-h-10 hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary rounded"
              >{t("footer.link.audiovisual")}</a
            >
          </li>
          <li>
            <a
              href="#planes"
              class="inline-flex items-center min-h-10 hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary rounded"
              >{t("footer.link.plansEquipment")}</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h3
          class="text-base font-semibold text-white mb-3 font-display"
        >
          {t("footer.colCompany")}
        </h3>
        <ul class="space-y-0.5 text-[0.9375rem] text-alivia-primary-mist">
          <li>
            <a
              href="#equipo"
              class="inline-flex items-center min-h-10 hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary rounded"
              >{t("footer.link.behindAlivia")}</a
            >
          </li>
          <li>
            <a
              href="#testimonios"
              class="inline-flex items-center min-h-10 hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary rounded"
              >{t("footer.link.testimonials")}</a
            >
          </li>
          <li>
            <a
              href="#faq"
              class="inline-flex items-center min-h-10 hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary rounded"
              >{t("footer.link.faq")}</a
            >
          </li>
          <li>
            <a
              href="https://resolum-alivia.alivia-resolum.workers.dev/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center min-h-10 hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary rounded"
              >{t("footer.link.caregiverApp")}</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h3
          class="text-base font-semibold text-white mb-3 font-display"
        >
          {t("footer.colContact")}
        </h3>
        <div class="space-y-3 text-[0.9375rem] text-alivia-primary-mist">
          <p>
            <strong class="block text-white">{companyInfo.legalName}</strong>
            <a
              href={`mailto:${companyInfo.privacyEmail}`}
              class="break-all underline underline-offset-4 decoration-alivia-primary-light hover:text-alivia-secondary"
              >{companyInfo.privacyEmail}</a
            >
          </p>
        </div>
      </div>
    </div>
    <div
      class="pt-8 pb-[env(safe-area-inset-bottom,0px)] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-sm text-alivia-primary-light"
    >
      <p>
        {t("footer.copyright")}
      </p>

      <div class="flex items-center gap-6">
        <a
          href={privacyHref}
          class="inline-flex items-center min-h-10 hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary"
          >{t("footer.privacy")}</a
        >
        <a
          href={termsHref}
          class="inline-flex items-center min-h-10 hover:text-alivia-secondary transition-colors focus-visible:ring-2 focus-visible:ring-alivia-secondary"
          >{t("footer.terms")}</a
        >
      </div>
    </div>
  </div>
</footer>
