---
interface Props {
  variant?: "info" | "success" | "warning";
  title?: string;
  text?: string;
  class?: string;
}

const { variant = "info", title, text, class: className = "" } = Astro.props;

// Tone fill carries the variant; no side stripe, no shadow
const variantStyles = {
  info: "bg-alivia-surface text-alivia-neutral-dark",
  success: "bg-alivia-tertiary text-alivia-neutral-dark",
  // Safety notice: the strongest block in the document, in brand colours
  warning: "bg-alivia-primary-deep text-alivia-hero-text",
};

const iconStyles = {
  info: "text-alivia-primary-medium",
  success: "text-alivia-secondary-dark",
  warning: "text-amber-300",
};
---

<div
  class:list={[
    "max-w-[62ch] p-5 sm:p-6 rounded-2xl flex items-start gap-3.5 !my-8",
    variantStyles[variant],
    className,
  ]}
  role="note"
  aria-label={title || "Aviso"}
>
  <div class:list={["shrink-0 mt-0.5", iconStyles[variant]]} aria-hidden="true">
    {
      variant === "info" && (
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      )
    }
    {
      variant === "success" && (
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      )
    }
    {
      variant === "warning" && (
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      )
    }
  </div>
  <div class="space-y-1 leading-relaxed min-w-0">
    {title && <p class:list={["font-semibold", variant === "warning" ? "text-white" : "text-alivia-primary"]}>{title}</p>}
    {text && <p>{text}</p>}
    <slot />
  </div>
</div>
