---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import { getIncludedDevices } from "../data/includedDevices";
import DeviceIcon from "./ui/DeviceIcon.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const devices = getIncludedDevices(t);
---

<div class="py-20 sm:py-28 bg-white text-alivia-neutral-dark">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <div class="lg:col-span-6 lg:sticky lg:top-32 text-left" data-reveal>
        <h2
          id="included-devices-title"
          class="text-[2rem] leading-[1.1] sm:text-5xl font-semibold font-display text-alivia-primary mb-5"
        >
          {t("includedDevices.title")}
        </h2>
        <p
          class="text-base sm:text-lg text-alivia-neutral-gray leading-relaxed mb-6 lg:mb-8"
        >
          {t("includedDevices.desc")}
        </p>
        <div
          class="hidden lg:flex flex-col items-start gap-4 pt-2"
        >
          <p class="text-sm text-alivia-neutral-gray leading-relaxed max-w-md">
            {t("includedDevices.note")}
          </p>
          <a
            href="#planes"
            class="inline-flex items-center justify-center px-6 py-3 rounded-lg text-base font-semibold bg-alivia-primary text-white hover:bg-alivia-primary-medium press focus-visible:ring-4 focus-visible:ring-alivia-primary-light touch-target"
          >
            {t("includedDevices.plansCta")}
          </a>
        </div>
      </div>
      <div class="lg:col-span-6">
        <ul
          class="flex flex-col gap-3"
          data-reveal-group
          aria-label={t("includedDevices.listLabel")}
        >
          {
            devices.map((device, i) => (
              <li class="flex items-start gap-4 sm:gap-6 p-5 sm:p-6 rounded-2xl bg-alivia-surface-mist" data-reveal={i % 2 ? "right" : "left"}>
                <div class="w-14 h-14 min-w-14 sm:w-[72px] sm:h-[72px] sm:min-w-[72px] rounded-xl bg-white flex items-center justify-center shrink-0 p-2 overflow-hidden">
                  <DeviceIcon device={device.id} />
                </div>
                <div class="flex-1 min-w-0">
                  <span class="eyebrow block mb-1">
                    {device.tag}
                  </span>
                  <h3 class="text-lg sm:text-xl font-semibold font-display text-alivia-primary mb-1 leading-snug">
                    {device.title}
                  </h3>
                  <p class="text-[0.9375rem] text-alivia-neutral-gray leading-relaxed">
                    {device.desc}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
        <div
          class="mt-10 flex flex-col items-start gap-4 lg:hidden"
        >
          <p class="text-[0.9375rem] text-alivia-neutral-gray leading-relaxed">
            {t("includedDevices.note")}
          </p>
          <a
            href="#planes"
            class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 rounded-lg text-base font-semibold bg-alivia-primary text-white hover:bg-alivia-primary-medium press focus-visible:ring-4 focus-visible:ring-alivia-primary-light touch-target text-center"
          >
            {t("includedDevices.plansCta")}
          </a>
        </div>
      </div>
    </div>
  </div>
</div>


