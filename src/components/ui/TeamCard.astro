---
import type { TeamMember } from "../../data/team";
import type { Lang } from "../../i18n/ui";

interface Props {
  member: TeamMember;
  lang?: Lang;
}
const { member, lang = "es" } = Astro.props;
const roleText =
  lang === "es"
    ? "Estudiante de Ingeniería de Software"
    : "Software Engineering Student";
---

<div class="p-5 sm:p-6 rounded-2xl bg-white flex flex-col" data-reveal="col">
  <div class="flex items-center gap-4 mb-4">
    {
      member.image ? (
        <img
          src={member.image.src}
          width={member.image.width}
          height={member.image.height}
          decoding="async"
          alt={member.name}
          class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl object-cover shrink-0 bg-alivia-tertiary"
          loading="lazy"
        />
      ) : (
        <div class="w-20 h-20 rounded-2xl bg-alivia-secondary-mint text-alivia-secondary-dark flex items-center justify-center shrink-0">
          <svg
            class="w-7 h-7"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d={member.iconPath}
            />
          </svg>
        </div>
      )
    }
    <div class="min-w-0">
      <h3 class="text-lg sm:text-xl font-semibold text-alivia-primary leading-tight">
        {member.name}
      </h3>
      <p class="mt-1 text-sm text-alivia-neutral-blue leading-snug">
        {roleText} <span class="tabular-nums">({member.code})</span>
      </p>
    </div>
  </div>
  <p class="text-[0.9375rem] text-alivia-neutral-gray leading-relaxed">{member.bio}</p>
</div>
